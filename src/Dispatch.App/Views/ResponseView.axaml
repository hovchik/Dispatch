<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:domain="using:Dispatch.Domain"
             xmlns:fmt="using:Dispatch.Application.Formatting"
             x:Class="Dispatch.App.Views.ResponseView"
             x:DataType="vm:ResponseViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Transport error (DNS, timeout, invalid URL, ...) -->
    <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding HasError}" VerticalAlignment="Top"
            Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="Could not get a response" FontWeight="SemiBold" Foreground="#EF4444" />
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding EffectiveUrl}" Classes="muted" FontFamily="{StaticResource MonoFont}"
                             IsVisible="{Binding EffectiveUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Status line: sits on the right of the Body/Headers tab strip. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,0" HorizontalAlignment="Right"
                Height="30" IsVisible="{Binding HasResponse}" ZIndex="1">
      <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
              Background="{Binding StatusCode, Converter={x:Static conv:StatusBrushConverter.Tint}}">
        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                   Foreground="{Binding StatusCode, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="Response time">
        <TextBlock Text="Time" Classes="muted" FontSize="12" />
        <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" FontSize="12" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="Response size">
        <TextBlock Text="Size" Classes="muted" FontSize="12" />
        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <TabControl Grid.Row="0" Grid.RowSpan="2" Classes="compact" IsVisible="{Binding HasResponse}" Padding="0">
      <TabItem Header="Body">
        <DockPanel Margin="0,6,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,6">
            <!-- Pretty / Raw switch -->
            <Border Classes="segmented">
              <StackPanel Orientation="Horizontal">
                <Button Classes="seg" Classes.selected="{Binding ShowPretty}" Content="Pretty"
                        Command="{Binding UsePrettyCommand}" />
                <Button Classes="seg" Classes.selected="{Binding ShowRaw}" Content="Raw"
                        Command="{Binding UseRawCommand}" />
              </StackPanel>
            </Border>
            <ComboBox Grid.Column="1" Classes="compact" Margin="8,0,0,0" MinWidth="96"
                      ItemsSource="{x:Static vm:ResponseViewModel.Formats}" SelectedItem="{Binding SelectedFormat}"
                      ToolTip.Tip="{Binding ContentType, StringFormat='Content-Type: {0}', TargetNullValue='No Content-Type header'}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="fmt:BodyFormat">
                  <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="2" IsVisible="{Binding IsTruncated}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                       Text="Large response: only the first 5 MB is shown." />
            <Button Grid.Column="3" Classes="icon compact" Command="{Binding CopyBodyCommand}" ToolTip.Tip="Copy body">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
                <TextBlock Text="{Binding CopyFeedback, FallbackValue=Copy, TargetNullValue=Copy}" FontSize="12"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <views:CodeEditor Text="{Binding DisplayBody, Mode=OneWay}" Format="{Binding SelectedFormat}"
                            IsReadOnly="True" />
        </DockPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Headers" VerticalAlignment="Center" />
            <TextBlock Text="{Binding HeaderCount}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Border Classes="card" Margin="0,6,0,0" Padding="0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Headers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:ResponseHeader">
                  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                    <Grid ColumnDefinitions="200,*">
                      <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                           TextWrapping="Wrap" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5"
                                           FontFamily="{StaticResource MonoFont}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
