<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:domain="using:Dispatch.Domain"
             xmlns:fmt="using:Dispatch.Application.Formatting"
             x:Class="Dispatch.App.Views.ResponseView"
             x:DataType="vm:ResponseViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Transport error (DNS, timeout, invalid URL, ...) -->
    <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding HasError}" VerticalAlignment="Top"
            Background="{DynamicResource ErrorSurfaceBrush}" BorderBrush="{DynamicResource DangerSoftBrush}" BorderThickness="1"
            CornerRadius="10" Padding="16" Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Could not get a response" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding EffectiveUrl}" Classes="muted" FontFamily="{StaticResource MonoFont}"
                             IsVisible="{Binding EffectiveUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageItemViewModel">
              <TextBlock Text="{Binding Content}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Status line: sits on the right of the tab strip. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0" HorizontalAlignment="Right"
                Height="30" IsVisible="{Binding HasResponse}" ZIndex="1">
      <Border Classes="pill" Padding="9,2" IsVisible="{Binding HasTests}"
              Background="{Binding AllTestsPassed, Converter={x:Static conv:PassBrushConverter.Instance}}">
        <TextBlock Text="{Binding TestsSummary, StringFormat='Tests {0}'}" FontWeight="SemiBold" FontSize="11.5" Foreground="White" />
      </Border>
      <Border Classes="pill" Padding="9,2" Background="{Binding StatusColorCode, Converter={x:Static conv:StatusBrushConverter.Tint}}">
        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11.5" MaxWidth="360" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusText}"
                   Foreground="{Binding StatusColorCode, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="Response time" Margin="4,0,0,0">
        <PathIcon Data="{StaticResource IconClock}" Width="11" Height="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" FontSize="11.5" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="Response size">
        <TextBlock Text="Size" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="11.5" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <TabControl Grid.Row="0" Grid.RowSpan="2" Classes="compact" IsVisible="{Binding HasResponse}" Padding="0">
      <TabItem Header="Body">
        <DockPanel Margin="0,6,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,6">
            <!-- Pretty / Raw switch -->
            <Border Classes="segmented">
              <StackPanel Orientation="Horizontal">
                <Button Classes="seg" Classes.selected="{Binding ShowPretty}" Content="Pretty"
                        Command="{Binding UsePrettyCommand}" />
                <Button Classes="seg" Classes.selected="{Binding ShowRaw}" Content="Raw"
                        Command="{Binding UseRawCommand}" />
              </StackPanel>
            </Border>
            <ComboBox Grid.Column="1" Classes="compact" Margin="8,0,0,0" MinWidth="96"
                      ItemsSource="{x:Static vm:ResponseViewModel.Formats}" SelectedItem="{Binding SelectedFormat}"
                      ToolTip.Tip="{Binding ContentType, StringFormat='Content-Type: {0}', TargetNullValue='No Content-Type header'}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="fmt:BodyFormat">
                  <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" Spacing="6">
              <TextBox Classes="mono" Text="{Binding Filter}" Watermark="Filter: $.items[*].id or //xpath" MinWidth="240" MinHeight="28"
                       FontSize="12" ToolTip.Tip="Show only what a JSONPath or XPath selects. Ctrl+F in the body searches text." />
              <TextBlock Text="{Binding FilterError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         MaxWidth="260" />
              <TextBlock IsVisible="{Binding IsTruncated}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                         Text="Only the first 5 MB is shown." />
            </StackPanel>
            <Button Grid.Column="3" Classes="icon compact" Command="{Binding SaveBodyCommand}" ToolTip.Tip="Save the body to a file (binary bodies are saved byte for byte)"
                    Margin="0,0,4,0">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconSave}" Width="12" Height="12" />
                <TextBlock Text="Save" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="icon compact" Command="{Binding CopyBodyCommand}" ToolTip.Tip="Copy body">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
                <TextBlock Text="{Binding CopyFeedback, FallbackValue=Copy, TargetNullValue=Copy}" FontSize="12"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <views:CodeEditor Text="{Binding DisplayBody, Mode=OneWay}" Format="{Binding SelectedFormat}" IsReadOnly="True" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Table" IsVisible="{Binding HasTable}">
        <DockPanel Margin="0,6,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <TextBox Classes="mono" Text="{Binding TablePath}" Watermark="Array to show (JSONPath), e.g. $.data" MinWidth="260" MinHeight="28" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding TableSummary}" Classes="muted" FontSize="12" Margin="10,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Classes="icon compact" Command="{Binding SaveTableCsvCommand}" ToolTip.Tip="Export the table as CSV">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" />
                <TextBlock Text="CSV" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="card" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="TableGrid" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                      GridLinesVisibility="All" HeadersVisibility="Column" FontSize="12" />
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Preview" IsVisible="{Binding HasPreview}">
        <DockPanel Margin="0,6,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Text="{Binding PreviewHint}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="compact" Command="{Binding OpenExternallyCommand}" Padding="10,3"
                    ToolTip.Tip="Open with your browser, image viewer or PDF reader">
              <TextBlock Text="Open externally" FontSize="12" />
            </Button>
          </Grid>
          <Panel>
            <DockPanel IsVisible="{Binding HasImage}">
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding ImageInfo}" Classes="muted" FontSize="11" Margin="0,6,0,0" />
              <Border Classes="card" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                  <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
              </Border>
            </DockPanel>
            <Border Classes="card" Padding="12" IsVisible="{Binding IsHtml}">
              <ScrollViewer>
                <SelectableTextBlock Text="{Binding HtmlText}" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </Panel>
        </DockPanel>
      </TabItem>

      <TabItem Header="Visualize" IsVisible="{Binding HasVisualization}">
        <DockPanel Margin="0,6,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Rendered by pm.visualizer.set(template, data) in the test script." />
            <Button Grid.Column="1" Classes="accent compact" Command="{Binding OpenVisualizationCommand}" Padding="10,3">
              <TextBlock Text="Open in browser" FontSize="12" />
            </Button>
          </Grid>
          <views:CodeEditor Text="{Binding Visualization, Mode=OneWay}" Format="Html" IsReadOnly="True" />
        </DockPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Headers" VerticalAlignment="Center" />
            <Border Classes="count"><TextBlock Text="{Binding HeaderCount}" /></Border>
          </StackPanel>
        </TabItem.Header>
        <Border Classes="card" Margin="0,6,0,0" Padding="0">
          <ScrollViewer>
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Headers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="domain:ResponseHeader">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                      <Grid ColumnDefinitions="220,*">
                        <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5"
                                             FontFamily="{StaticResource MonoFont}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="TRAILERS" Classes="section" Margin="10,10,0,4" IsVisible="{Binding HasTrailers}" />
              <ItemsControl ItemsSource="{Binding Trailers}" IsVisible="{Binding HasTrailers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="domain:ResponseHeader">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                      <Grid ColumnDefinitions="220,*">
                        <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5"
                                             FontFamily="{StaticResource MonoFont}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem IsVisible="{Binding HasTests}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Tests" VerticalAlignment="Center" />
            <Border Classes="count"><TextBlock Text="{Binding TestsSummary}"
                       Foreground="{Binding AllTestsPassed, Converter={x:Static conv:PassBrushConverter.Instance}}" /></Border>
          </StackPanel>
        </TabItem.Header>
        <Border Classes="card" Margin="0,6,0,0" Padding="0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tests}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:TestResult">
                  <Border Classes="message">
                    <Grid ColumnDefinitions="24,*">
                      <TextBlock Text="{Binding Passed, Converter={x:Static conv:PassTextConverter.Instance}}" FontWeight="Bold"
                                 Foreground="{Binding Passed, Converter={x:Static conv:PassBrushConverter.Instance}}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Message}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                             FontFamily="{StaticResource MonoFont}"
                                             IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem IsVisible="{Binding HasMessages}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Messages" VerticalAlignment="Center" />
            <Border Classes="count"><TextBlock Text="{Binding MessageCount}" /></Border>
          </StackPanel>
        </TabItem.Header>
        <Border Classes="card" Margin="0,6,0,0" ClipToBounds="True">
          <views:MessageLog Items="{Binding Messages}" />
        </Border>
      </TabItem>

      <TabItem Header="Timeline" IsVisible="{Binding HasRawRequest}">
        <ScrollViewer Margin="0,6,0,0">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding Timings}" IsVisible="{Binding HasTimings}" MaxWidth="700" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimingBar">
                  <Grid ColumnDefinitions="170,*,80" Margin="0,2">
                    <TextBlock Text="{Binding Label}" FontSize="12" Classes="muted" />
                    <ProgressBar Grid.Column="1" Classes="bar" Minimum="0" Maximum="1" Value="{Binding Fraction}" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="REQUEST AS SENT" Classes="section" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon compact" Command="{Binding CopyRawRequestCommand}" ToolTip.Tip="Copy">
                <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
              </Button>
            </Grid>
            <Border Classes="card" Padding="10">
              <SelectableTextBlock Text="{Binding RawRequest}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding EffectiveUrl, StringFormat='Final URL: {0}'}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Console" IsVisible="{Binding HasScriptLog}">
        <Border Classes="card" Margin="0,6,0,0" Padding="10">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ScriptLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="Variables" IsVisible="{Binding HasVariableUpdates}">
        <Border Classes="card" Margin="0,6,0,0" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" FontSize="12" Text="Set by extraction rules and scripts during this send:" />
            <SelectableTextBlock Text="{Binding VariableUpdatesText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="JWT" IsVisible="{Binding HasJwt}">
        <ScrollViewer Margin="0,6,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="A JSON Web Token was found in the body (decoded, not verified)." Classes="muted" FontSize="12" />
            <TextBlock Text="HEADER" Classes="section" />
            <Border Classes="card" Padding="10">
              <SelectableTextBlock Text="{Binding Jwt.HeaderJson}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
            </Border>
            <TextBlock Text="PAYLOAD" Classes="section" />
            <Border Classes="card" Padding="10">
              <SelectableTextBlock Text="{Binding Jwt.PayloadJson}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
