<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:views="using:Dispatch.App.Views"
             x:Class="Dispatch.App.Views.EnvironmentsView"
             x:DataType="vm:EnvironmentsViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="14,0,10,6">
      <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="Variables used as {{name}} in requests. Pick the active one at the top right." />
      <Button Grid.Column="1" Classes="icon" Command="{Binding AddCommand}" ToolTip.Tip="New environment" VerticalAlignment="Top">
        <PathIcon Data="{StaticResource IconPlus}" />
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Classes="error" Text="{Binding Error}" Margin="12,0,12,6"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <ListBox Grid.Row="2" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
             MaxHeight="220" Margin="6,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EnvironmentItemViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconGlobe}" Width="12" Height="12" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource AccentGradientBrush}" IsVisible="{Binding IsDirty}"
                     ToolTip.Tip="Unsaved changes" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Editor for the selected environment -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0"
            IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Selected}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:EnvironmentItemViewModel">
            <DockPanel Margin="12,10,12,12">
              <TextBlock DockPanel.Dock="Top" Text="NAME" Classes="eyebrow" Margin="2,0,0,4" />
              <TextBox DockPanel.Dock="Top" Text="{Binding Name}" Margin="0,0,0,10" />
              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                <Button Classes="danger compact" Content="Delete" Command="{Binding DeleteCommand}" />
                <Button Grid.Column="2" Content="Save" Classes="accent compact" Command="{Binding SaveCommand}" />
              </Grid>
              <TextBlock DockPanel.Dock="Top" Text="VARIABLES" Classes="eyebrow" Margin="2,0,0,6" />
              <views:KeyValueEditor DataContext="{Binding Variables}" />
            </DockPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>
  </Grid>
</UserControl>
