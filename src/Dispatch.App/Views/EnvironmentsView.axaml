<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:views="using:Dispatch.App.Views"
             x:Class="Dispatch.App.Views.EnvironmentsView"
             x:DataType="vm:EnvironmentsViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="12,10,10,6">
      <TextBlock Text="ENVIRONMENTS" Classes="section" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="icon" Command="{Binding AddCommand}" ToolTip.Tip="New environment">
        <PathIcon Data="{StaticResource IconPlus}" />
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="#EF4444" TextWrapping="Wrap" Margin="12,0"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <ListBox Grid.Row="2" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
             MaxHeight="220">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EnvironmentItemViewModel">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Name}" />
            <TextBlock Text="•" Foreground="#2F6BFF" IsVisible="{Binding IsDirty}"
                       ToolTip.Tip="Unsaved changes" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Editor for the selected environment -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0"
            IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Selected}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:EnvironmentItemViewModel">
            <DockPanel Margin="10">
              <TextBlock DockPanel.Dock="Top" Text="NAME" Classes="section" Margin="2,0,0,4" />
              <TextBox DockPanel.Dock="Top" Text="{Binding Name}" Margin="0,0,0,10" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                          HorizontalAlignment="Right">
                <Button Content="Delete" Command="{Binding DeleteCommand}" />
                <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,8"
                         Text="Use variables anywhere as {{name}}." />
              <views:KeyValueEditor DataContext="{Binding Variables}" />
            </DockPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>
  </Grid>
</UserControl>
