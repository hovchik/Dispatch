<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             x:Class="Dispatch.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,0,10,8">
      <TextBox Text="{Binding Filter}" Watermark="Filter by URL, status or name" MinHeight="30" FontSize="12.5">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconFilter}" Width="12" Height="12" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="1" Classes="icon" Command="{Binding ClearCommand}" Margin="4,0,0,0"
              IsVisible="{Binding !IsEmpty}" ToolTip.Tip="Delete all history">
        <PathIcon Data="{StaticResource IconTrash}" />
      </Button>
    </Grid>

    <Border DockPanel.Dock="Top" Classes="card" Margin="10,0,10,6" Padding="10,6"
            IsVisible="{Binding CompareBase, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                   Text="Comparing: pick a second entry and choose “Compare with selected”." />
        <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCompareCommand}" ToolTip.Tip="Cancel">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" Margin="12,0,12,6"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Panel>
      <StackPanel Margin="16,28" Spacing="8" IsVisible="{Binding IsEmpty}">
        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
          <PathIcon Data="{StaticResource IconClock}" Width="16" Height="16" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
        <TextBlock Text="No history yet" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Text="Requests you send will appear here." />
      </StackPanel>

      <ListBox Classes="plain" ItemsSource="{Binding Items}" Margin="6,0">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:HistoryItemViewModel">
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItemViewModel">
            <Grid ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto" Background="Transparent"
                  Tapped="OnItemTapped" ToolTip.Tip="{Binding Url}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open in new tab" Command="{Binding OpenCommand}" />
                  <MenuItem Header="{Binding CompareHeader}" Command="{Binding CompareCommand}"
                            IsEnabled="{Binding CanCompare}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconDiff}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <TextBlock Grid.RowSpan="2" Classes="method"
                         Text="{Binding Badge, Converter={x:Static conv:MethodTextConverter.Instance}}"
                         Foreground="{Binding Badge, Converter={x:Static conv:BadgeBrushConverter.Instance}}" />
              <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" />
              <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11"
                         Margin="8,0,0,0"
                         Foreground="{Binding StatusCode, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                          Margin="0,2,0,0">
                <TextBlock Text="{Binding WhenText}" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding ElapsedText}" Classes="muted" FontSize="11" />
                <TextBlock Text="◆ compare base" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                           IsVisible="{Binding IsCompareBase}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
