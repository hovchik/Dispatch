<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             x:Class="Dispatch.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,10,10,6">
      <TextBlock Text="RECENT REQUESTS" Classes="section" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Padding="10,4"
              IsVisible="{Binding !IsEmpty}" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="#EF4444" TextWrapping="Wrap" Margin="12,0"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Panel>
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="16" TextAlignment="Center"
                 Text="Requests you send will appear here." IsVisible="{Binding IsEmpty}" />

      <ListBox Classes="plain" ItemsSource="{Binding Items}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItemViewModel">
            <Grid ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto" Background="Transparent"
                  Tapped="OnItemTapped" ToolTip.Tip="{Binding Url}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open in new tab" Command="{Binding OpenCommand}" />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <TextBlock Grid.RowSpan="2" Classes="method"
                         Text="{Binding Method, Converter={x:Static conv:MethodTextConverter.Instance}}"
                         Foreground="{Binding Method, Converter={x:Static conv:MethodBrushConverter.Instance}}" />
              <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" />
              <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11"
                         Margin="8,0,0,0"
                         Foreground="{Binding StatusCode, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                          Margin="0,2,0,0">
                <TextBlock Text="{Binding WhenText}" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding ElapsedText}" Classes="muted" FontSize="11" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
