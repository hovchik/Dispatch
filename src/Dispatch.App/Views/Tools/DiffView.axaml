<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:conv="using:Dispatch.App.Converters"
             xmlns:diff="using:Dispatch.Application.Diff"
             x:Class="Dispatch.App.Views.Tools.DiffView"
             x:DataType="tools:DiffViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,10">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding LeftTitle}" FontWeight="SemiBold" Foreground="#EF4444" />
        <TextBlock Text="{Binding LeftStatus}" Classes="muted" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="{Binding RightTitle}" FontWeight="SemiBold" Foreground="#22A06B" />
        <TextBlock Text="{Binding RightStatus}" Classes="muted" FontSize="12" />
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,10">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>

    <TabControl Classes="compact">
      <TabItem Header="Structural (JSON)" IsVisible="{Binding IsJson}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,8">
            <TextBlock Classes="label" Text="Ignore paths" />
            <TextBox Grid.Column="1" Text="{Binding IgnorePaths}" Classes="mono"
                     Watermark="e.g. $.timestamp, $.data[*].id, $..updatedAt (comma separated)" />
          </Grid>
          <Panel>
            <TextBlock Classes="muted" Margin="8" Text="No structural differences." IsVisible="{Binding Identical}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding JsonChanges}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="diff:JsonChange">
                    <Border Classes="message">
                      <Grid ColumnDefinitions="110,*">
                        <TextBlock Text="{Binding Kind, Converter={x:Static conv:EnumLabelConverter.Instance}}" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <SelectableTextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                          <SelectableTextBlock Text="{Binding Left, StringFormat='− {0}'}" Foreground="#EF4444" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               TextWrapping="Wrap" IsVisible="{Binding Left, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <SelectableTextBlock Text="{Binding Right, StringFormat='+ {0}'}" Foreground="#22A06B" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               TextWrapping="Wrap" IsVisible="{Binding Right, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </TabItem>
      <TabItem Header="Line diff">
        <Border Classes="card" Padding="0" Margin="0,8,0,0">
          <ListBox ItemsSource="{Binding Lines}" Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="tools:DiffLineViewModel">
                <Grid ColumnDefinitions="44,44,18,*" Background="{Binding Kind, Converter={x:Static conv:DiffBrushConverter.Instance}}">
                  <TextBlock Text="{Binding LeftNumber}" Classes="muted" TextAlignment="Right" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="1" Text="{Binding RightNumber}" Classes="muted" TextAlignment="Right" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Marker}" />
                  <TextBlock Grid.Column="3" Text="{Binding Text}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
