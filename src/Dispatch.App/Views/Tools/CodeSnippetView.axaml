<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:conv="using:Dispatch.App.Converters"
             xmlns:interop="using:Dispatch.Application.Interop"
             x:Class="Dispatch.App.Views.Tools.CodeSnippetView"
             x:DataType="tools:CodeSnippetViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
      <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" MinWidth="180" IsVisible="{Binding HasTargets}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="interop:CodeTarget">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Grid.Column="1" Content="Resolve variables" IsChecked="{Binding ResolveVariables}" Margin="12,0,0,0" />
      <TextBlock Grid.Column="2" Text="{Binding CopyFeedback}" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Grid.Column="3" Command="{Binding CopyCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
          <TextBlock Text="Copy" />
        </StackPanel>
      </Button>
    </Grid>
    <Border Classes="card" Padding="0">
      <views:CodeEditor Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" />
    </Border>
  </DockPanel>
</UserControl>
