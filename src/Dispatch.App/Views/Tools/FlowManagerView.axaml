<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             xmlns:domain="using:Dispatch.Domain"
             x:Class="Dispatch.App.Views.Tools.FlowManagerView"
             x:DataType="tools:FlowManagerViewModel">
  <DockPanel Margin="18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Test flows" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="New flow" Classes="accent" Command="{Binding NewCommand}" VerticalAlignment="Center" Padding="12,5" />
    </Grid>
    <Border Classes="card" Padding="0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Flows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="domain:TestFlow">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Steps.Count, StringFormat='{}{0} step(s)'}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Open" Padding="10,3"
                          Command="{Binding $parent[ItemsControl].((tools:FlowManagerViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0"
                          Command="{Binding $parent[ItemsControl].((tools:FlowManagerViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
