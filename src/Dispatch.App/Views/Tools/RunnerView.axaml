<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:conv="using:Dispatch.App.Converters"
             xmlns:domain="using:Dispatch.Domain"
             xmlns:running="using:Dispatch.Application.Running"
             x:Class="Dispatch.App.Views.Tools.RunnerView"
             x:DataType="tools:RunnerViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.th TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Grid.row TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="320,*" Margin="18">
    <!-- Setup -->
    <DockPanel Margin="0,0,16,0">
      <TextBlock DockPanel.Dock="Top" Text="{Binding CollectionName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Classes="label" Text="Iterations" />
          <NumericUpDown Grid.Column="1" Value="{Binding Iterations}" Minimum="1" Maximum="100000" Width="130" FormatString="0" />
          <TextBlock Grid.Row="1" Classes="label" Text="Delay between requests (ms)" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DelayMs}" Minimum="0" Maximum="600000" Width="130" FormatString="0" />
        </Grid>
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="label" Text="Data file (CSV / JSON)" />
            <Button Grid.Column="1" Content="Choose…" Command="{Binding ChooseDataFileCommand}" Padding="8,3" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding ClearDataFileCommand}" ToolTip.Tip="Remove data file" Margin="4,0,0,0"
                    IsVisible="{Binding DataFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
          <TextBlock Text="{Binding DataFile}" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding DataSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox Content="Stop on first failure" IsChecked="{Binding StopOnFailure}" />
        <CheckBox Content="Save extracted variables to environment" IsChecked="{Binding PersistVariables}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RunCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" />
              <TextBlock Text="Run" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding StopCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" />
              <TextBlock Text="Stop" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
        <TextBlock Classes="section" Text="REQUESTS (IN ORDER)" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="All" Command="{Binding SelectAllCommand}" CommandParameter="{x:True}" Padding="6,2" FontSize="11" />
        <Button Grid.Column="2" Content="None" Command="{Binding SelectAllCommand}" CommandParameter="{x:False}" Padding="6,2" FontSize="11" Margin="4,0,0,0" />
      </Grid>
      <Border Classes="card" Padding="4">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Requests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tools:SelectableRequest">
                <CheckBox IsChecked="{Binding IsSelected}" Margin="4,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="method" MinWidth="40" Text="{Binding Badge, Converter={x:Static conv:MethodTextConverter.Instance}}"
                               Foreground="{Binding Badge, Converter={x:Static conv:BadgeBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <!-- Results -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding PassedCount, StringFormat='{}{0} passed'}" />
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Text="{Binding FailedCount, StringFormat='{}{0} failed'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding OpenReportCommand}" ToolTip.Tip="Open the HTML report in your browser">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" />
              <TextBlock Text="Open in browser" />
            </StackPanel>
          </Button>
          <DropDownButton Content="Export report">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="HTML report…" Command="{Binding ExportCommand}" CommandParameter="html" />
                <MenuItem Header="JUnit XML (CI)…" Command="{Binding ExportCommand}" CommandParameter="junit" />
                <MenuItem Header="JSON…" Command="{Binding ExportCommand}" CommandParameter="json" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="4" Margin="0,8">
        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" MinHeight="4" />
        <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
        <TabItem Header="Results">
          <Grid RowDefinitions="*,Auto,170">
            <Border Classes="card" Padding="0">
              <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="tools:RunResultItem">
                    <Grid ColumnDefinitions="22,50,*,Auto,Auto,70">
                      <TextBlock Text="{Binding Passed, Converter={x:Static conv:PassTextConverter.Instance}}" FontWeight="Bold"
                                 Foreground="{Binding Passed, Converter={x:Static conv:PassBrushConverter.Instance}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Iteration}" Classes="muted" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding TestsText}" Classes="muted" Margin="10,0" />
                      <TextBlock Grid.Column="4" Text="{Binding Status}" Margin="10,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="5" Text="{Binding Time}" Classes="muted" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <TextBlock Grid.Row="1" Classes="section" Text="SELECTED RESULT" Margin="0,10,0,4" />
            <Border Grid.Row="2" Classes="card" Padding="8">
              <Panel>
                <TextBlock Classes="hint" Text="Select a result above to see its status and test outcomes." VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsVisible="{Binding SelectedResult, Converter={x:Static ObjectConverters.IsNull}}" />
                <ContentControl Content="{Binding SelectedResult}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="tools:RunResultItem">
                      <DockPanel>
                        <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ScrollViewer>
                          <ItemsControl ItemsSource="{Binding Tests}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="domain:TestResult">
                                <Grid ColumnDefinitions="22,*">
                                  <TextBlock Text="{Binding Passed, Converter={x:Static conv:PassTextConverter.Instance}}" FontWeight="Bold"
                                             Foreground="{Binding Passed, Converter={x:Static conv:PassBrushConverter.Instance}}" />
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Panel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Report">
          <Panel>
            <StackPanel IsVisible="{Binding !HasReport}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" MaxWidth="360">
              <PathIcon Data="{StaticResource IconChart}" Width="32" Height="32" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="No report yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="hint" TextAlignment="Center"
                         Text="When the run finishes, a detailed report appears here: pass rate, insights, per-request results, every failure and the slowest calls." />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding HasReport}">
              <StackPanel Spacing="14" Margin="0,0,10,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="pill" Background="{Binding VerdictBrush}">
                    <TextBlock Text="{Binding Verdict}" Foreground="White" FontWeight="Bold" FontSize="12" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CollectionName, StringFormat='Run summary · {0}'}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ReportSubtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding ReportStats}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="8" RowSpacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel>
                  <TextBlock Classes="section" Text="INSIGHTS" Margin="0,0,0,6" />
                  <ItemsControl ItemsSource="{Binding Insights}" />
                </StackPanel>

                <Border Classes="panel">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="panelTitle" Text="Per request (times in ms)" />
                    <Grid Classes="th" ColumnDefinitions="*,90,48,48,48,56,48,48,48" ColumnSpacing="4" Margin="0,0,0,4">
                      <TextBlock Text="REQUEST" />
                      <TextBlock Grid.Column="1" Text="PASS RATE" />
                      <TextBlock Grid.Column="2" Text="RUNS" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="PASS" TextAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="FAIL" TextAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="TESTS" TextAlignment="Right" />
                      <TextBlock Grid.Column="6" Text="AVG" TextAlignment="Right" />
                      <TextBlock Grid.Column="7" Text="MIN" TextAlignment="Right" />
                      <TextBlock Grid.Column="8" Text="MAX" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ReportRequests}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tools:RunRequestRow">
                          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                            <StackPanel>
                              <Grid Classes="row" ColumnDefinitions="*,90,48,48,48,56,48,48,48" ColumnSpacing="4">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip.Tip="{Binding Name}" />
                                <ProgressBar Grid.Column="1" Classes="bar" Value="{Binding PassRate}" Maximum="100" Foreground="{Binding PassBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Runs}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Passed}" TextAlignment="Right" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Failed}" TextAlignment="Right" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasFailures}" />
                                <TextBlock Grid.Column="4" Text="{Binding Failed}" TextAlignment="Right" Classes="muted" IsVisible="{Binding !HasFailures}" />
                                <TextBlock Grid.Column="5" Text="{Binding Tests}" TextAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="{Binding Mean}" TextAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="{Binding Min}" TextAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="{Binding Max}" TextAlignment="Right" />
                              </Grid>
                              <TextBlock Text="{Binding Statuses, StringFormat='status {0}'}" Classes="muted" FontSize="11" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="panel" IsVisible="{Binding HasFailures}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="panelTitle" Text="Failures" />
                    <ItemsControl ItemsSource="{Binding Failures}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="running:FailureDetail">
                          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                            <Grid ColumnDefinitions="22,*">
                              <TextBlock Text="✗" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                              <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock TextWrapping="Wrap">
                                  <Run Text="{Binding Request}" FontWeight="SemiBold" /><Run Text="  #" Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Iteration}" Foreground="{DynamicResource MutedTextBrush}" /><Run Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Check}" />
                                </TextBlock>
                                <SelectableTextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <Border Classes="panel">
                    <StackPanel>
                      <TextBlock Classes="panelTitle" Text="Slowest calls" />
                      <ItemsControl ItemsSource="{Binding Slowest}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="tools:RunResultItem">
                            <Grid ColumnDefinitions="*,Auto,64" ColumnSpacing="8" Margin="0,3">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                              <TextBlock Grid.Column="1" Text="{Binding Iteration}" Classes="muted" FontSize="12" />
                              <TextBlock Grid.Column="2" Text="{Binding Time}" TextAlignment="Right" FontSize="12.5" FontWeight="SemiBold" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="panel">
                    <StackPanel>
                      <TextBlock Classes="panelTitle" Text="Status codes" />
                      <ItemsControl ItemsSource="{Binding StatusBars}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
