<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             xmlns:cap="using:Dispatch.Application.Capture"
             xmlns:domain="using:Dispatch.Domain"
             xmlns:conv="using:Dispatch.App.Converters"
             x:Class="Dispatch.App.Views.Tools.CaptureView"
             x:DataType="tools:CaptureViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="16">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,0,10" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Port" Classes="label" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Port}" Minimum="0" Maximum="65535" Width="110" FormatString="0" />
      </StackPanel>
      <TextBox Grid.Column="1" Text="{Binding HostFilter}" Watermark="host filter (optional)" MinWidth="170" VerticalAlignment="Center" />
      <CheckBox Grid.Column="2" Content="Decrypt HTTPS" IsChecked="{Binding DecryptHttps}" VerticalAlignment="Center" />
      <Button Grid.Column="3" Content="Export CA…" Command="{Binding ExportCaCommand}" VerticalAlignment="Center" Padding="10,4"
              ToolTip.Tip="Save the CA certificate and trust it so HTTPS clients don't warn" />
      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
        <Button Classes="accent" Command="{Binding StartCommand}" Padding="12,4">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" /><TextBlock Text="Start" /></StackPanel>
        </Button>
        <Button Command="{Binding StopCommand}" Padding="12,4">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" /><TextBlock Text="Stop" /></StackPanel>
        </Button>
      </StackPanel>
      <Button Grid.Column="6" Content="Clear" Command="{Binding ClearCommand}" VerticalAlignment="Center" Padding="10,4" />
      <DropDownButton Grid.Column="7" Content="Save" VerticalAlignment="Center">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="Save as collection" Command="{Binding SaveToCollectionCommand}" />
            <MenuItem Header="Export HAR…" Command="{Binding ExportHarCommand}" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="9" Height="9" Fill="#22A06B" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,2.2*" ColumnSpacing="12">
      <Border Classes="card" Padding="0">
        <ListBox ItemsSource="{Binding Exchanges}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="cap:CapturedExchange">
              <Grid ColumnDefinitions="Auto,46,*,Auto" Margin="2">
                <TextBlock Text="🔒" FontSize="10" IsVisible="{Binding Secure}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Method}" Classes="method" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Margin="4,0">
                  <TextBlock Text="{Binding Path}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Host}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding StatusCode}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{Binding StatusCode, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="0">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="8" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <SelectableTextBlock Text="{Binding Selected.Url}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Classes="muted">
              <Run Text="{Binding Selected.Method}" /><Run Text=" → " /><Run Text="{Binding Selected.StatusCode}" /><Run Text=" " /><Run Text="{Binding Selected.ReasonPhrase}" />
              <Run Text="  ·  " /><Run Text="{Binding Selected.ElapsedMs, StringFormat='{}{0:0} ms'}" />
            </TextBlock>
            <TextBlock Text="REQUEST HEADERS" Classes="section" />
            <ItemsControl ItemsSource="{Binding Selected.RequestHeaders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:KeyValueItem">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5"><Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Value}" /></TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="REQUEST BODY" Classes="section" IsVisible="{Binding Selected.RequestBody, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <SelectableTextBlock Text="{Binding Selected.RequestBody}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap"
                                 IsVisible="{Binding Selected.RequestBody, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="RESPONSE BODY" Classes="section" />
            <SelectableTextBlock Text="{Binding Selected.ResponseBody}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
