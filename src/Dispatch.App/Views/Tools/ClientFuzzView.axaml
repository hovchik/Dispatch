<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             x:Class="Dispatch.App.Views.Tools.ClientFuzzView"
             x:DataType="tools:ClientFuzzViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="Border.running">
      <Setter Property="Background" Value="#2622A06B" />
    </Style>
    <Style Selector="Border.stopped">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16">
    <!-- Header: title, state, proxy address, start / stop -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,10">
      <TextBlock Text="Client fuzzing" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border Grid.Column="1" Classes="pill" Classes.running="{Binding IsRunning}" Classes.stopped="{Binding !IsRunning}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
          <Ellipse Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsRunning}" />
          <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Proxy" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          <SelectableTextBlock Text="{Binding ProxyAddress}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Classes="icon" Command="{Binding CopyAddressCommand}" ToolTip.Tip="Copy proxy address" Padding="4" IsVisible="{Binding IsRunning}">
            <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Command="{Binding StartCommand}" Padding="16,6">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" /><TextBlock Text="Start" /></StackPanel>
        </Button>
        <Button Command="{Binding StopCommand}" Padding="16,6">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" /><TextBlock Text="Stop" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
      <SelectableTextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="16">
      <!-- Settings -->
      <ScrollViewer>
        <StackPanel Spacing="10" Margin="0,0,6,0">
          <TextBlock Classes="hint"
                     Text="Tests the app, not the API: one response at a time is varied (null fields, empty lists, 500s, …) and Dispatch watches whether the app retries in a loop, sends broken values like /users/undefined, reports an error or stops working." />

          <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,6" IsVisible="{Binding IsRunning}">
            <TextBlock Classes="hint" Text="Stop fuzzing to change these settings." />
          </Border>

          <Border Classes="panel" IsEnabled="{Binding !IsRunning}">
            <StackPanel Spacing="10">
              <TextBlock Classes="panelTitle" Text="Proxy" Margin="0" />
              <StackPanel>
                <TextBlock Classes="fieldLabel" Text="Port" />
                <NumericUpDown Value="{Binding Port}" Minimum="0" Maximum="65535" FormatString="0" HorizontalAlignment="Stretch" />
                <TextBlock Classes="hint" Text="0 picks a free port." Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="fieldLabel" Text="Only hosts containing" />
                <TextBox Text="{Binding HostFilter}" Watermark="e.g. api.myapp.com (blank = all)" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="panel" IsEnabled="{Binding !IsRunning}">
            <StackPanel Spacing="10">
              <TextBlock Classes="panelTitle" Text="Experiment" Margin="0" />
              <StackPanel>
                <TextBlock Classes="fieldLabel" Text="Normal responses first" />
                <NumericUpDown Value="{Binding Baseline}" Minimum="1" Maximum="20" FormatString="0" HorizontalAlignment="Stretch" />
                <TextBlock Classes="hint" Text="Unchanged responses per endpoint before varying it, so the app is in a normal state." Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="fieldLabel" Text="Watch window (seconds)" />
                <NumericUpDown Value="{Binding WindowSeconds}" Minimum="1" Maximum="120" FormatString="0" HorizontalAlignment="Stretch" />
                <TextBlock Classes="hint" Text="How long to watch the app after each changed response." Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="fieldLabel" Text="Max variations per endpoint" />
                <NumericUpDown Value="{Binding MaxPerEndpoint}" Minimum="1" Maximum="500" FormatString="0" HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="panel" IsEnabled="{Binding !IsRunning}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="panelTitle" Text="Variations" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="All" Command="{Binding SelectAllKindsCommand}" />
                <Button Grid.Column="2" Classes="link" Content="None" Command="{Binding SelectNoKindsCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding KindGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="tools:MutationKindGroup">
                    <StackPanel Margin="0,4,0,2">
                      <TextBlock Classes="section" Text="{Binding Name}" Margin="0,0,0,2" />
                      <ItemsControl ItemsSource="{Binding Kinds}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="tools:MutationKindOption">
                            <CheckBox IsChecked="{Binding IsEnabled}" FontSize="12" ToolTip.Tip="{Binding Label}">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="10">
              <TextBlock Classes="panelTitle" Text="HTTPS" Margin="0" />
              <StackPanel IsEnabled="{Binding !IsRunning}">
                <CheckBox IsChecked="{Binding DecryptHttps}" Content="Decrypt HTTPS traffic" />
                <TextBlock Classes="hint" Text="Needed to vary HTTPS responses. The device must trust Dispatch's CA." />
              </StackPanel>
              <Button Command="{Binding ExportCaCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconKey}" Width="12" Height="12" />
                  <TextBlock Text="Export CA certificate…" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Live results -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
        <UniformGrid Columns="3" ColumnSpacing="8">
          <Border Classes="stat">
            <StackPanel>
              <TextBlock Classes="statvalue" Text="{Binding Tried}" />
              <TextBlock Text="Variations tried" Classes="muted" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel>
              <TextBlock Classes="statvalue" Text="{Binding Breaks}" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="Broke the app" Classes="muted" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel>
              <TextBlock Classes="statvalue" Text="{Binding Copes}" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Text="Handled fine" Classes="muted" FontSize="11" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"
                   IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,12,0,8">
          <ToggleButton IsChecked="{Binding BreaksOnly}" Content="Breaks only" />
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
          <DropDownButton Grid.Column="2" Content="Export report">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="HTML report…" Command="{Binding ExportCommand}" CommandParameter="html" />
                <MenuItem Header="JSON…" Command="{Binding ExportCommand}" CommandParameter="json" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Grid>

        <Border Grid.Row="3" Classes="card" Padding="0">
          <Panel>
            <StackPanel IsVisible="{Binding !HasVisible}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="20" MaxWidth="320">
              <TextBlock Text="No variations yet" FontWeight="SemiBold" HorizontalAlignment="Center" IsVisible="{Binding !HasExperiments}" />
              <TextBlock Classes="hint" TextAlignment="Center" IsVisible="{Binding !HasExperiments}"
                         Text="Click Start, point the app under test at the proxy address above and use it as usual. Each varied response and how the app reacted shows up here." />
              <TextBlock Text="Nothing broke so far" FontWeight="SemiBold" HorizontalAlignment="Center" IsVisible="{Binding HasExperiments}" />
              <TextBlock Classes="hint" TextAlignment="Center" IsVisible="{Binding HasExperiments}"
                         Text="Turn off Breaks only to see every variation." />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding HasVisible}">
              <ItemsControl ItemsSource="{Binding Visible}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="tools:FuzzExperimentItem">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Top" Width="64" Margin="0,1,0,0" Background="{Binding BadgeBrush}">
                          <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Badge}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <SelectableTextBlock Text="{Binding Endpoint}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Variation}" FontSize="12.5" TextWrapping="Wrap" />
                          <SelectableTextBlock Text="{Binding Result}" FontSize="12" TextWrapping="Wrap" Foreground="{Binding BadgeBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Classes="muted" VerticalAlignment="Top" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
