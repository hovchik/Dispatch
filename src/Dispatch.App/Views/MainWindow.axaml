<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dispatch.App.ViewModels"
        xmlns:views="using:Dispatch.App.Views"
        xmlns:conv="using:Dispatch.App.Converters"
        xmlns:domain="using:Dispatch.Domain"
        xmlns:tools="using:Dispatch.App.ViewModels.Tools"
        x:Class="Dispatch.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Dispatch"
        Icon="/Assets/dispatch.ico"
        Width="1400" Height="880" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseSelectedTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding SelectedTab.DuplicateCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+PageUp" Command="{Binding SelectedTab.MoveLeftCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+PageDown" Command="{Binding SelectedTab.MoveRightCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenImportCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding ToggleLayoutCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ShowHelpCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Rail buttons highlight the panel that is currently open. -->
    <Style Selector="Button.railitem.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.railitem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Welcome steps -->
    <Style Selector="Border.step">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.stepnum">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.stepnum TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Command palette rows -->
    <Style Selector="ListBox.palette ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,Auto,*">

      <!-- ================= Header ================= -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1" Height="50">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0">
          <!-- Brand -->
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="2,0,0,0">
            <Image Source="/Assets/dispatch-logo.png" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Dispatch" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" LetterSpacing="-0.2" />
          </StackPanel>

          <!-- Primary actions -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="22,0,0,0" VerticalAlignment="Center">
            <SplitButton Classes="accent" Command="{Binding NewTabCommand}" Padding="12,0" MinHeight="32"
                         ToolTip.Tip="New HTTP request (Ctrl+T) · arrow: other protocols">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" Foreground="White" />
                <TextBlock Text="New" FontWeight="SemiBold" Foreground="White" />
              </StackPanel>
              <SplitButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="HTTP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Http}" />
                  <MenuItem Header="GraphQL" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.GraphQl}" />
                  <MenuItem Header="gRPC" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Grpc}" />
                  <MenuItem Header="SOAP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Soap}" />
                  <Separator />
                  <MenuItem Header="WebSocket" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.WebSocket}" />
                  <MenuItem Header="Server-Sent Events" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Sse}" />
                  <MenuItem Header="Socket.IO" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.SocketIo}" />
                  <Separator />
                  <MenuItem Header="MQTT" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Mqtt}" />
                  <MenuItem Header="Kafka" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Kafka}" />
                  <MenuItem Header="AMQP (RabbitMQ)" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Amqp}" />
                  <Separator />
                  <MenuItem Header="TCP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Tcp}" />
                  <MenuItem Header="UDP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Udp}" />
                </MenuFlyout>
              </SplitButton.Flyout>
            </SplitButton>
            <Button Classes="tool" Command="{Binding OpenImportCommand}"
                    ToolTip.Tip="Import Postman, OpenAPI, Insomnia, Thunder Client, Hoppscotch, Bruno, HAR, WSDL, .proto, .http or cURL (Ctrl+O)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconImport}" />
                <TextBlock Text="Import" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Command palette launcher -->
          <Button Grid.Column="2" HorizontalAlignment="Center" Width="420" MaxWidth="520" MinHeight="32" Padding="10,0"
                  Command="{Binding OpenPaletteCommand}" ToolTip.Tip="Search requests and run commands (Ctrl+K)"
                  Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource DividerBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Grid.Column="1" Text="Search requests, collections and commands" Classes="muted" Margin="9,0,12,0"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Normal" />
              <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl K" /></Border>
            </Grid>
          </Button>

          <!-- Environment -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding Environments.Choices}" SelectedItem="{Binding Environments.Active}" MinWidth="190"
                      ToolTip.Tip="Active environment: its variables replace {{placeholders}} when sending">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EnvironmentItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconGlobe}" Width="12" Height="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="icon" Margin="4,0,0,0" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle light / dark theme">
              <Panel>
                <PathIcon Data="{StaticResource IconMoon}" IsVisible="{Binding IsDarkTheme}" />
                <PathIcon Data="{StaticResource IconSun}" IsVisible="{Binding !IsDarkTheme}" />
              </Panel>
            </Button>
            <Button Classes="icon" ToolTip.Tip="Help, examples and getting started (F1)">
              <PathIcon Data="{StaticResource IconHelp}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="User guide" InputGesture="F1" Command="{Binding ShowHelpCommand}" />
                  <MenuItem Header="Getting started" Command="{Binding ShowWelcomeCommand}" />
                  <MenuItem Header="Load example collection" Command="{Binding LoadSamplesCommand}" />
                  <MenuItem Header="Keyboard shortcuts" Command="{Binding ShowHelpCommand}" CommandParameter="shortcuts" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= Banners ================= -->
      <StackPanel Grid.Row="1" Spacing="6">
        <Border Classes="banner error" Margin="12,8,12,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
              <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
            </Button>
          </Grid>
        </Border>
        <Border Classes="banner info" Margin="12,8,12,0"
                IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding InfoMessage}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Command="{Binding DismissInfoCommand}" ToolTip.Tip="Dismiss">
              <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ================= Body ================= -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*">

        <!-- Activity rail -->
        <Border Grid.Column="0" Classes="rail">
          <DockPanel Margin="0,8,0,8">
            <StackPanel DockPanel.Dock="Bottom" Spacing="0">
              <Button Classes="railitem" Command="{Binding OpenCookiesCommand}" ToolTip.Tip="Cookie jar" ToolTip.Placement="Right">
                <StackPanel><PathIcon Data="{StaticResource IconCookie}" /><TextBlock Text="Cookies" /></StackPanel>
              </Button>
              <Button Classes="railitem" Command="{Binding ShowHelpCommand}" ToolTip.Tip="User guide (F1)" ToolTip.Placement="Right">
                <StackPanel><PathIcon Data="{StaticResource IconHelp}" /><TextBlock Text="Help" /></StackPanel>
              </Button>
            </StackPanel>

            <StackPanel>
              <Button Classes="railitem" Classes.active="{Binding IsCollectionsActive}" Command="{Binding ShowSidebarCommand}"
                      CommandParameter="{x:Static vm:SidebarSection.Collections}" ToolTip.Tip="Collections" ToolTip.Placement="Right">
                <StackPanel><PathIcon Data="{StaticResource IconCollections}" /><TextBlock Text="Collections" /></StackPanel>
              </Button>
              <Button Classes="railitem" Classes.active="{Binding IsHistoryActive}" Command="{Binding ShowSidebarCommand}"
                      CommandParameter="{x:Static vm:SidebarSection.History}" ToolTip.Tip="History" ToolTip.Placement="Right">
                <StackPanel><PathIcon Data="{StaticResource IconClock}" /><TextBlock Text="History" /></StackPanel>
              </Button>
              <Button Classes="railitem" Classes.active="{Binding IsEnvironmentsActive}" Command="{Binding ShowSidebarCommand}"
                      CommandParameter="{x:Static vm:SidebarSection.Environments}" ToolTip.Tip="Environments" ToolTip.Placement="Right">
                <StackPanel><PathIcon Data="{StaticResource IconGlobe}" /><TextBlock Text="Envs" /></StackPanel>
              </Button>

              <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,8" />

              <Button Classes="railitem" Command="{Binding OpenRunnerCommand}" ToolTip.Placement="Right"
                      ToolTip.Tip="Runner: run the current collection with assertions and reports">
                <StackPanel><PathIcon Data="{StaticResource IconPlay}" /><TextBlock Text="Runner" /></StackPanel>
              </Button>
              <Button Classes="railitem" Command="{Binding OpenMockServerCommand}" ToolTip.Placement="Right"
                      ToolTip.Tip="Mock server: serve the collection's saved examples locally">
                <StackPanel><PathIcon Data="{StaticResource IconServer}" /><TextBlock Text="Mock" /></StackPanel>
              </Button>
              <Button Classes="railitem" Command="{Binding OpenLoadTestCommand}" ToolTip.Placement="Right"
                      ToolTip.Tip="Load test requests with virtual users">
                <StackPanel><PathIcon Data="{StaticResource IconChart}" /><TextBlock Text="Load" /></StackPanel>
              </Button>
              <Button Classes="railitem" Command="{Binding OpenCaptureCommand}" ToolTip.Placement="Right"
                      ToolTip.Tip="Capture: record proxied HTTP/HTTPS traffic into a collection">
                <StackPanel><PathIcon Data="{StaticResource IconCapture}" /><TextBlock Text="Capture" /></StackPanel>
              </Button>
              <Button Classes="railitem" Command="{Binding OpenClientFuzzCommand}" ToolTip.Placement="Right"
                      ToolTip.Tip="Fuzz app: vary responses to your app through a proxy (nulls, empty lists, 500s…) and see what breaks">
                <StackPanel><PathIcon Data="{StaticResource IconFlask}" /><TextBlock Text="Fuzz app" /></StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Width="300" MinWidth="240"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding IsSidebarOpen}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="sidebarHeader">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="sidebarTitle" Text="{Binding SidebarTitle}" />
                <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Hide sidebar (Ctrl+B)">
                  <PathIcon Data="{StaticResource IconSidebar}" Width="13" Height="13" />
                </Button>
              </Grid>
            </Border>
            <Panel>
              <views:CollectionsView DataContext="{Binding Collections}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsCollectionsActive}" />
              <views:HistoryView DataContext="{Binding History}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsHistoryActive}" />
              <views:EnvironmentsView DataContext="{Binding Environments}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsEnvironmentsActive}" />
            </Panel>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="2" Width="4" Margin="-2,0" Background="Transparent" ResizeDirection="Columns"
                      IsVisible="{Binding IsSidebarOpen}" />

        <!-- Workspace -->
        <Grid Grid.Column="3" RowDefinitions="Auto,*">
          <!-- Tab strip -->
          <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}" Padding="8,8,8,0"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <ListBox x:Name="TabStrip" Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                       ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       DragDrop.AllowDrop="True">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RequestTabViewModel">
                    <Panel x:Name="TabRoot" Width="204" Height="36" Background="Transparent" ToolTip.Tip="{Binding Url}">
                      <Panel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
                          <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
                          <MenuItem Header="Duplicate" InputGesture="Ctrl+Shift+D" Command="{Binding DuplicateCommand}" />
                          <Separator />
                          <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}" />
                          <MenuItem Header="Move right" Command="{Binding MoveRightCommand}" />
                          <MenuItem Header="Move to start" Command="{Binding MoveToStartCommand}" />
                          <MenuItem Header="Move to end" Command="{Binding MoveToEndCommand}" />
                          <Separator />
                          <MenuItem Header="Close" InputGesture="Ctrl+W" Command="{Binding CloseCommand}" />
                        </ContextMenu>
                      </Panel.ContextMenu>
                      <Border Classes="tabline" Height="2" VerticalAlignment="Top" Margin="8,0" CornerRadius="1"
                              Background="{StaticResource AccentGradientBrush}" IsHitTestVisible="False" />
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Classes="method" Margin="12,0,8,0"
                                   Text="{Binding Badge, Converter={x:Static conv:MethodTextConverter.Instance}}"
                                   Foreground="{Binding Badge, Converter={x:Static conv:BadgeBrushConverter.Instance}}" />
                        <!-- Requests not yet saved to a collection show their title in italics. -->
                        <TextBlock Grid.Column="1" Classes="tabtitle" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}"
                                   Classes.unsaved="{Binding !IsSaved}" DoubleTapped="OnTabTitleDoubleTapped" />
                        <TextBox Grid.Column="1" Classes="tabrename" Text="{Binding RenameText}"
                                 IsVisible="{Binding IsRenaming}" VerticalAlignment="Center" LostFocus="OnTabRenameLostFocus">
                          <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                          </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2" Classes="icon tabsave" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
                          <PathIcon Data="{StaticResource IconSave}" Width="11" Height="11" />
                        </Button>
                        <Popup Grid.Column="2" IsOpen="{Binding IsSavePopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #TabRoot}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
                          <Border Classes="card raised" Padding="18" Width="340" BoxShadow="0 12 32 0 #50000000" Margin="0,4,0,0">
                            <StackPanel Spacing="10">
                              <TextBlock Text="Save request" FontWeight="SemiBold" FontSize="14" />
                              <TextBlock Text="NAME" Classes="eyebrow" />
                              <TextBox Text="{Binding Name}" Watermark="Request name" />
                              <TextBlock Text="COLLECTION" Classes="eyebrow" />
                              <ComboBox ItemsSource="{Binding SaveTargets}" SelectedItem="{Binding SaveTarget}"
                                        HorizontalAlignment="Stretch" PlaceholderText="A new collection will be created">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:CollectionNodeViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Cancel" Command="{Binding CancelSaveCommand}" />
                                <Button Content="Save" Classes="accent" Command="{Binding ConfirmSaveCommand}" IsDefault="True" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </Popup>
                        <Panel Grid.Column="3" Width="28" Margin="0,0,4,0">
                          <!-- Dirty tabs show a dot; hovering the tab swaps it for the close button. -->
                          <Ellipse Classes="dirtydot" Width="7" Height="7" Fill="{StaticResource AccentGradientBrush}"
                                   IsVisible="{Binding IsDirty}" IsHitTestVisible="False" />
                          <Button Classes="icon tabclose" Classes.dirty="{Binding IsDirty}" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Ctrl+W)">
                            <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                          </Button>
                        </Panel>
                      </Grid>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- Shown when tabs don't fit; lists the hidden ones vertically. -->
              <Button x:Name="TabOverflowButton" Grid.Column="1" Classes="icon" Margin="4,0,0,6" IsVisible="False"
                      ToolTip.Tip="More tabs" Click="OnTabOverflowClick">
                <PathIcon Data="{StaticResource IconChevronDown}" />
              </Button>
              <Button Grid.Column="2" Classes="icon" Command="{Binding NewTabCommand}" Margin="4,0,0,6" ToolTip.Tip="New request (Ctrl+T)">
                <PathIcon Data="{StaticResource IconPlus}" />
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
            <Panel>
              <ContentControl Content="{Binding SelectedTab}" IsVisible="{Binding HasTabs}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:RequestTabViewModel">
                    <views:RequestTabView />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>

              <!-- Empty state -->
              <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="460">
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconSend}" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <TextBlock Text="No open requests" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Open one from a collection or history, or start a new one." />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                  <Button Classes="accent" Content="New request" Command="{Binding NewTabCommand}" Padding="16,8" />
                  <Button Content="Try an example" Command="{Binding LoadSamplesCommand}" Padding="16,8"
                          ToolTip.Tip="Adds a collection of ready-made requests that show each feature" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <Border Classes="kbd"><TextBlock Text="F1" /></Border>
                  <TextBlock Classes="muted" FontSize="12" Text="user guide" VerticalAlignment="Center" />
                  <TextBlock Classes="faint" FontSize="12" Text="·" VerticalAlignment="Center" Margin="4,0" />
                  <Border Classes="kbd"><TextBlock Text="Ctrl K" /></Border>
                  <TextBlock Classes="muted" FontSize="12" Text="search and commands" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ================= Welcome card (first launch, or Help → Getting started) ================= -->
    <Border Background="{DynamicResource ScrimBrush}" IsVisible="{Binding IsWelcomeOpen}">
      <Border Classes="card raised" Width="660" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24"
              CornerRadius="14" BoxShadow="0 24 64 0 #70000000">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" Background="{StaticResource AccentGradientBrush}">
              <Image Source="/Assets/dispatch-logo.png" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="Welcome to Dispatch" FontSize="20" FontWeight="SemiBold" LetterSpacing="-0.3" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Send API requests over HTTP, GraphQL, gRPC, WebSocket and more, and test the responses." />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Command="{Binding DismissWelcomeCommand}" ToolTip.Tip="Close">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
            <Border Classes="step">
              <StackPanel Spacing="3">
                <Border Classes="stepnum"><TextBlock Text="1" /></Border>
                <TextBlock Text="Send a request" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Type a URL in the address bar and press Send or Ctrl+Enter. The response opens below." />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="step">
              <StackPanel Spacing="3">
                <Border Classes="stepnum"><TextBlock Text="2" /></Border>
                <TextBlock Text="Save it to a collection" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Ctrl+S keeps the request in Collections. Import (Ctrl+O) brings in Postman, OpenAPI or cURL." />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Classes="step">
              <StackPanel Spacing="3">
                <Border Classes="stepnum"><TextBlock Text="3" /></Border>
                <TextBlock Text="Reuse values with variables" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Write {{baseUrl}} in a request, define it in an environment, then switch environments at the top right." />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Classes="step">
              <StackPanel Spacing="3">
                <Border Classes="stepnum"><TextBlock Text="4" /></Border>
                <TextBlock Text="Test the response" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Add assertions in the Tests tab, then run a whole collection with the Runner or the dispatch CLI." />
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Classes="accent" Padding="14,7" Command="{Binding WelcomeLoadSamplesCommand}"
                    ToolTip.Tip="Adds a collection of ready-made requests and opens the first one">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconSparkle}" Width="13" Height="13" Foreground="White" />
                <TextBlock Text="Explore the examples" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Padding="14,7" Content="Read the guide" Command="{Binding WelcomeShowHelpCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="3" Classes="ghost" Padding="14,7" Content="Start from scratch" Command="{Binding DismissWelcomeCommand}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="kbd"><TextBlock Text="F1" /></Border>
            <TextBlock Classes="muted" FontSize="12" Text="opens the guide" VerticalAlignment="Center" />
            <TextBlock Classes="faint" FontSize="12" Text="·" VerticalAlignment="Center" Margin="4,0" />
            <Border Classes="kbd"><TextBlock Text="Ctrl K" /></Border>
            <TextBlock Classes="muted" FontSize="12" Text="searches requests and commands" VerticalAlignment="Center" />
            <TextBlock Classes="faint" FontSize="12" Text="·" VerticalAlignment="Center" Margin="4,0" />
            <TextBlock Classes="muted" FontSize="12" Text="the ? button brings this screen back" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ================= Command palette (Ctrl+K) ================= -->
    <Border Background="{DynamicResource ScrimBrush}" IsVisible="{Binding Palette.IsOpen}" PointerPressed="OnPaletteBackdropPressed">
      <Border Classes="card raised" Width="640" MaxHeight="520" VerticalAlignment="Top" Margin="0,90,0,0" Padding="0"
              CornerRadius="12" BoxShadow="0 24 64 0 #70000000" ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
              <TextBox x:Name="PaletteQuery" Grid.Column="1" Classes="bare" Text="{Binding Palette.Query}" FontSize="15" Margin="6,0"
                       Watermark="Type a request name, URL or command…" VerticalContentAlignment="Center">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding Palette.RunCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding Palette.CloseCommand}" />
                  <KeyBinding Gesture="Down" Command="{Binding Palette.MoveCommand}" CommandParameter="down" />
                  <KeyBinding Gesture="Up" Command="{Binding Palette.MoveCommand}" CommandParameter="up" />
                </TextBox.KeyBindings>
              </TextBox>
              <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Esc" /></Border>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="↑↓" /></Border>
              <TextBlock Classes="muted" FontSize="11.5" Text="navigate" VerticalAlignment="Center" />
              <Border Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Enter" /></Border>
              <TextBlock Classes="muted" FontSize="11.5" Text="open" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="16,12" Text="No matches."
                     IsVisible="{Binding Palette.Items.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
          <ListBox x:Name="PaletteList" Classes="plain palette" ItemsSource="{Binding Palette.Items}"
                   SelectedItem="{Binding Palette.Selected}" Margin="6,6">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="tools:PaletteItem">
                <Grid ColumnDefinitions="*,Auto" Background="Transparent" Tapped="OnPaletteItemTapped">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Hint}" Classes="muted" FontSize="11.5" Margin="12,0,0,0"
                             MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
