<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dispatch.App.ViewModels"
        xmlns:views="using:Dispatch.App.Views"
        xmlns:conv="using:Dispatch.App.Converters"
        xmlns:domain="using:Dispatch.Domain"
        xmlns:tools="using:Dispatch.App.ViewModels.Tools"
        x:Class="Dispatch.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Dispatch"
        Icon="/Assets/dispatch.ico"
        Width="1360" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseSelectedTabCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenImportCommand}" />
  </Window.KeyBindings>

  <Panel>
  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Top bar -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1" Padding="14,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="/Assets/dispatch-logo.png" Width="24" Height="24"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Dispatch" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="20,0,0,0">
          <SplitButton Command="{Binding NewTabCommand}" Padding="10,5" ToolTip.Tip="New HTTP request (Ctrl+T); arrow for other protocols">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
              <TextBlock Text="New" />
            </StackPanel>
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="HTTP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Http}" />
                <MenuItem Header="GraphQL" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.GraphQl}" />
                <MenuItem Header="gRPC" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Grpc}" />
                <MenuItem Header="SOAP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Soap}" />
                <Separator />
                <MenuItem Header="WebSocket" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.WebSocket}" />
                <MenuItem Header="Server-Sent Events" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Sse}" />
                <MenuItem Header="Socket.IO" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.SocketIo}" />
                <Separator />
                <MenuItem Header="MQTT" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Mqtt}" />
                <MenuItem Header="Kafka" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Kafka}" />
                <MenuItem Header="AMQP (RabbitMQ)" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Amqp}" />
                <Separator />
                <MenuItem Header="TCP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Tcp}" />
                <MenuItem Header="UDP" Command="{Binding NewRequestCommand}" CommandParameter="{x:Static domain:RequestKind.Udp}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <Button Classes="tool" Margin="8,0,0,0" Command="{Binding OpenImportCommand}"
                  ToolTip.Tip="Import Postman, OpenAPI, Insomnia, HAR, WSDL, .proto, .http or cURL (Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconImport}" />
              <TextBlock Text="Import" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OpenRunnerCommand}" ToolTip.Tip="Run the current collection with assertions and reports">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconPlay}" />
              <TextBlock Text="Runner" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OpenMockServerCommand}" ToolTip.Tip="Serve the current collection's saved examples locally">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconServer}" />
              <TextBlock Text="Mock" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OpenLoadTestCommand}" ToolTip.Tip="Load test requests with virtual users">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconChart}" />
              <TextBlock Text="Load test" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OpenCookiesCommand}" ToolTip.Tip="Cookie jar">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconCookie}" />
              <TextBlock Text="Cookies" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Button Grid.Column="2" HorizontalAlignment="Center" MinWidth="240" Margin="12,0" Padding="10,5"
                Command="{Binding OpenPaletteCommand}" ToolTip.Tip="Search requests and commands (Ctrl+K)">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" Text="Search requests &amp; commands" Classes="muted" Margin="8,0,16,0" />
            <TextBlock Grid.Column="2" Text="Ctrl K" Classes="muted" FontSize="11" FontFamily="{StaticResource MonoFont}" />
          </Grid>
        </Button>

        <ComboBox Grid.Column="3" ItemsSource="{Binding Environments.Choices}"
                  SelectedItem="{Binding Environments.Active}" MinWidth="200"
                  ToolTip.Tip="Active environment: its variables replace {{placeholders}} when sending">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EnvironmentItemViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="4" Classes="icon" Margin="8,0,0,0" Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Toggle light / dark theme">
          <PathIcon Data="{StaticResource IconMoon}" />
        </Button>
      </Grid>
    </Border>

    <!-- Error banner -->
    <Border Grid.Row="1" Background="{DynamicResource ErrorSurfaceBrush}" Padding="14,8"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Grid>
    </Border>

    <!-- Info banner -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" Padding="14,6"
            IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding DismissInfoCommand}" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource IconClose}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="300,Auto,*">
      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" MinWidth="220">
        <TabControl Padding="0" Margin="6,0,0,0">
          <TabItem Header="Collections">
            <views:CollectionsView DataContext="{Binding Collections}" />
          </TabItem>
          <TabItem Header="History">
            <views:HistoryView DataContext="{Binding History}" />
          </TabItem>
          <TabItem Header="Environments">
            <views:EnvironmentsView DataContext="{Binding Environments}" />
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" ResizeDirection="Columns" />

      <!-- Workspace -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}" Padding="8,6,8,0"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <ListBox Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RequestTabViewModel">
                  <Grid x:Name="TabRoot" ColumnDefinitions="Auto,*,Auto,Auto" Width="210" Height="34"
                        Background="Transparent" ToolTip.Tip="{Binding Url}">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
                        <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
                        <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <TextBlock Classes="method" Margin="10,0,6,0"
                               Text="{Binding Badge, Converter={x:Static conv:MethodTextConverter.Instance}}"
                               Foreground="{Binding Badge, Converter={x:Static conv:BadgeBrushConverter.Instance}}" />
                    <!-- Requests not yet saved to a collection show their title in italics. -->
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}"
                               Classes.unsaved="{Binding !IsSaved}"
                               DoubleTapped="OnTabTitleDoubleTapped" />
                    <TextBox Grid.Column="1" Classes="tabrename" Text="{Binding RenameText}"
                             IsVisible="{Binding IsRenaming}" VerticalAlignment="Center"
                             LostFocus="OnTabRenameLostFocus">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                        <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="2" Classes="icon tabsave"
                            Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
                      <PathIcon Data="{StaticResource IconSave}" Width="11" Height="11" />
                    </Button>
                    <Popup Grid.Column="2" IsOpen="{Binding IsSavePopupOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding #TabRoot}" Placement="BottomEdgeAlignedLeft"
                           IsLightDismissEnabled="True">
                      <Border Classes="card" Padding="16" Width="320" BoxShadow="0 8 24 0 #40000000">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Save request" FontWeight="SemiBold" FontSize="14" />
                          <TextBlock Text="Name" Classes="section" />
                          <TextBox Text="{Binding Name}" Watermark="Request name" />
                          <TextBlock Text="Collection" Classes="section" />
                          <ComboBox ItemsSource="{Binding SaveTargets}" SelectedItem="{Binding SaveTarget}"
                                    HorizontalAlignment="Stretch" PlaceholderText="A new collection will be created">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:CollectionNodeViewModel">
                                <TextBlock Text="{Binding Name}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Cancel" Command="{Binding CancelSaveCommand}" />
                            <Button Content="Save" Classes="accent" Command="{Binding ConfirmSaveCommand}" IsDefault="True" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Popup>
                    <Panel Grid.Column="3" Width="26">
                      <!-- Dirty tabs show a dot; hovering the tab swaps it for the close button. -->
                      <Ellipse Classes="dirtydot" Width="7" Height="7" Fill="#FF6C37" IsVisible="{Binding IsDirty}"
                               IsHitTestVisible="False" />
                      <Button Classes="icon tabclose" Classes.dirty="{Binding IsDirty}"
                              Command="{Binding CloseCommand}" ToolTip.Tip="Close (Ctrl+W)">
                        <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                      </Button>
                    </Panel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Classes="icon" Command="{Binding NewTabCommand}" Margin="4,0,0,4"
                    ToolTip.Tip="New request (Ctrl+T)">
              <PathIcon Data="{StaticResource IconPlus}" />
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
          <Panel>
            <ContentControl Content="{Binding SelectedTab}" IsVisible="{Binding HasTabs}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:RequestTabViewModel">
                  <views:RequestTabView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
              <TextBlock Text="No open requests" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" HorizontalAlignment="Center"
                         Text="Open one from a collection or history, or start a new one." />
              <Button Classes="accent" Content="New request" Command="{Binding NewTabCommand}"
                      HorizontalAlignment="Center" Padding="16,8" />
            </StackPanel>
          </Panel>
        </Border>
      </Grid>
    </Grid>
  </Grid>

  <!-- Command palette (Ctrl+K) -->
  <Border Background="#66000000" IsVisible="{Binding Palette.IsOpen}" PointerPressed="OnPaletteBackdropPressed">
    <Border Classes="card" Width="620" MaxHeight="480" VerticalAlignment="Top" Margin="0,80,0,0" Padding="0"
            BoxShadow="0 12 40 0 #60000000">
      <DockPanel>
        <TextBox x:Name="PaletteQuery" DockPanel.Dock="Top" Text="{Binding Palette.Query}" Margin="10"
                 Watermark="Type a request name, URL or command…">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding Palette.RunCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding Palette.CloseCommand}" />
            <KeyBinding Gesture="Down" Command="{Binding Palette.MoveCommand}" CommandParameter="down" />
            <KeyBinding Gesture="Up" Command="{Binding Palette.MoveCommand}" CommandParameter="up" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="16,0,16,10" Text="No matches."
                   IsVisible="{Binding Palette.Items.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
        <ListBox x:Name="PaletteList" Classes="plain" ItemsSource="{Binding Palette.Items}"
                 SelectedItem="{Binding Palette.Selected}" Margin="6,0,6,6">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="tools:PaletteItem">
              <Grid ColumnDefinitions="*,Auto" Background="Transparent" Tapped="OnPaletteItemTapped">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Hint}" Classes="muted" FontSize="11" Margin="12,0,0,0"
                           MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Border>
  </Panel>
</Window>
