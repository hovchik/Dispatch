<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="using:Dispatch.App.ViewModels.Tools"
        xmlns:tv="using:Dispatch.App.Views.Tools"
        x:Class="Dispatch.App.Views.ToolWindow"
        Icon="/Assets/dispatch.ico"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
  <Window.DataTemplates>
    <DataTemplate DataType="tools:ImportViewModel"><tv:ImportView /></DataTemplate>
    <DataTemplate DataType="tools:RunnerViewModel"><tv:RunnerView /></DataTemplate>
    <DataTemplate DataType="tools:MockServerViewModel"><tv:MockServerView /></DataTemplate>
    <DataTemplate DataType="tools:LoadTestViewModel"><tv:LoadTestView /></DataTemplate>
    <DataTemplate DataType="tools:SecurityScanViewModel"><tv:SecurityScanView /></DataTemplate>
    <DataTemplate DataType="tools:FlowBuilderViewModel"><tv:FlowBuilderView /></DataTemplate>
    <DataTemplate DataType="tools:FlowManagerViewModel"><tv:FlowManagerView /></DataTemplate>
    <DataTemplate DataType="tools:MonitorManagerViewModel"><tv:MonitorManagerView /></DataTemplate>
    <DataTemplate DataType="tools:MonitorEditorViewModel"><tv:MonitorEditorView /></DataTemplate>
    <DataTemplate DataType="tools:CookiesViewModel"><tv:CookiesView /></DataTemplate>
    <DataTemplate DataType="tools:DiffViewModel"><tv:DiffView /></DataTemplate>
    <DataTemplate DataType="tools:CodeSnippetViewModel"><tv:CodeSnippetView /></DataTemplate>
    <DataTemplate DataType="tools:CollectionSettingsViewModel"><tv:CollectionSettingsView /></DataTemplate>
  </Window.DataTemplates>
  <ContentControl Content="{ReflectionBinding}" />
</Window>
