<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             x:Class="Dispatch.App.Views.CollectionsView"
             x:DataType="vm:CollectionsViewModel">

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,0,10,8">
      <TextBox Text="{Binding Filter}" Watermark="Search collections and requests" MinHeight="30" FontSize="12.5">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" Margin="8,0,0,0"
                    Foreground="{DynamicResource MutedTextBrush}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Classes="icon" Padding="6,4" Command="{Binding ClearFilterCommand}" ToolTip.Tip="Clear search"
                  IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
          </Button>
        </TextBox.InnerRightContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" Command="{Binding NewCollectionCommand}"
              ToolTip.Tip="New collection">
        <PathIcon Data="{StaticResource IconPlus}" />
      </Button>
    </Grid>

    <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" Margin="12,0,12,6"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Panel>
      <StackPanel Margin="16,28" Spacing="10" IsVisible="{Binding Items.Count, Converter={x:Static conv:IsZeroConverter.Instance}}">
        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
          <PathIcon Data="{StaticResource IconCollections}" Width="16" Height="16" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
        <TextBlock Text="No collections yet" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Click + to create one, save a request, or import a Postman / OpenAPI / HAR file." />
        <Button HorizontalAlignment="Center" Classes="compact" Content="Add example collection"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadSamplesCommand}"
                ToolTip.Tip="Ready-made requests that show tests, variables, chaining, scripts and auth" />
      </StackPanel>

      <TextBlock Classes="muted" Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                 Text="No requests match your search." IsVisible="{Binding HasNoMatches}" />

      <!-- Horizontal scrolling is disabled: long names are trimmed with an ellipsis instead, and
           selecting/expanding an item no longer jerks the tree left and right. -->
      <TreeView ItemsSource="{Binding Items}" Padding="4,0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
          </Style>
          <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="6" />
          </Style>
          <!-- Quick actions on collection rows only show on hover / selection to keep the list calm. -->
          <Style Selector="Grid.collrow StackPanel.quick">
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="Grid.collrow:pointerover StackPanel.quick">
            <Setter Property="Opacity" Value="1" />
          </Style>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            <Setter Property="MinHeight" Value="28" />
          </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:CollectionNodeViewModel" ItemsSource="{Binding Children}">
            <Grid Classes="collrow" ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add request" Command="{Binding AddRequestCommand}" />
                  <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" />
                  <MenuItem Header="Settings &amp; variables…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Settings}" />
                  <Separator />
                  <MenuItem Header="Run collection…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Run}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Load test…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.LoadTest}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconChart}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Mock server…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Mock}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconServer}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Test flows…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Flows}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconFlow}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Monitors…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Monitors}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconClock}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Security scan…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Scan}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconShield}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="API laws…" Command="{Binding ActionCommand}"
                            CommandParameter="{x:Static vm:CollectionAction.Laws}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconFlask}" Width="12" Height="12" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Generate API docs">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconFile}" Width="12" Height="12" /></MenuItem.Icon>
                    <MenuItem Header="HTML page (opens in your browser)…" Command="{Binding ActionCommand}"
                              CommandParameter="{x:Static vm:CollectionAction.DocsHtml}" />
                    <MenuItem Header="Markdown…" Command="{Binding ActionCommand}"
                              CommandParameter="{x:Static vm:CollectionAction.DocsMarkdown}" />
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Export">
                    <MenuItem.Icon><PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" /></MenuItem.Icon>
                    <MenuItem Header="Dispatch file (.json)…" Command="{Binding ActionCommand}"
                              CommandParameter="{x:Static vm:CollectionAction.ExportDispatch}" />
                    <MenuItem Header="Folder, one file per request (git-friendly)…" Command="{Binding ActionCommand}"
                              CommandParameter="{x:Static vm:CollectionAction.ExportFolder}" />
                    <MenuItem Header="Postman collection v2.1…" Command="{Binding ActionCommand}"
                              CommandParameter="{x:Static vm:CollectionAction.ExportPostman}" />
                    <MenuItem Header=".http file…" Command="{Binding ActionCommand}"
                              CommandParameter="{x:Static vm:CollectionAction.ExportHttp}" />
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Delete collection" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>

              <PathIcon Data="{StaticResource IconCollections}" Width="14" Height="14" Margin="0,0,8,0"
                        Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
              <TextBox Grid.Column="1" Classes="rename" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}"
                       LostFocus="OnRenameBoxLostFocus" MinHeight="26" Padding="6,2">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <StackPanel Grid.Column="2" Classes="quick" Orientation="Horizontal" Margin="4,0,0,0"
                          IsVisible="{Binding !IsRenaming}">
                <Button Classes="icon" Padding="4" Command="{Binding AddRequestCommand}" ToolTip.Tip="Add request">
                  <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" />
                </Button>
                <Button Classes="icon" Padding="4" Command="{Binding ActionCommand}"
                        CommandParameter="{x:Static vm:CollectionAction.Run}" ToolTip.Tip="Run collection">
                  <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" />
                </Button>
              </StackPanel>
              <Border Grid.Column="3" Classes="count" Margin="4,0,4,0" ToolTip.Tip="Requests in this collection">
                <TextBlock Text="{Binding RequestCount}" />
              </Border>
            </Grid>
          </TreeDataTemplate>

          <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,*" Background="Transparent" ToolTip.Tip="{Binding Path}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add request" Command="{Binding AddRequestCommand}" />
                  <MenuItem Header="Rename folder" Command="{Binding StartRenameCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,8,0" Opacity="0.7"
                        Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
              <TextBox Grid.Column="1" Classes="rename" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}"
                       LostFocus="OnRenameBoxLostFocus" MinHeight="26" Padding="6,2">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
          </TreeDataTemplate>

          <DataTemplate DataType="vm:RequestNodeViewModel">
            <Grid ColumnDefinitions="46,*" Background="Transparent" Tapped="OnRequestTapped"
                  ToolTip.Tip="{Binding Model.Url}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                  <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                  <MenuItem Header="Move to folder…" Command="{Binding StartMoveCommand}" />
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <TextBlock Classes="method" Text="{Binding Badge, Converter={x:Static conv:MethodTextConverter.Instance}}"
                         Foreground="{Binding Badge, Converter={x:Static conv:BadgeBrushConverter.Instance}}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsMoving}" />
              <TextBox Grid.Column="1" Classes="rename" Text="{Binding MoveTarget}" IsVisible="{Binding IsMoving}"
                       Watermark="folder/sub-folder (empty = root)" LostFocus="OnRenameBoxLostFocus"
                       MinHeight="26" Padding="6,2">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitMoveCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelMoveCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </Panel>
  </DockPanel>
</UserControl>
