<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             x:Class="Dispatch.App.Views.CollectionsView"
             x:DataType="vm:CollectionsViewModel">

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,10,10,6">
      <TextBox Text="{Binding Filter}" Watermark="Search collections" />
      <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" Command="{Binding NewCollectionCommand}"
              ToolTip.Tip="New collection">
        <PathIcon Data="{StaticResource IconPlus}" />
      </Button>
    </Grid>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="#EF4444" TextWrapping="Wrap" Margin="12,0"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Panel>
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="16" TextAlignment="Center"
                 Text="No collections yet. Click + to create one, or save a request."
                 IsVisible="{Binding Items.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />

      <TreeView ItemsSource="{Binding Items}" Padding="4,0">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            <Setter Property="MinHeight" Value="30" />
          </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:CollectionNodeViewModel" ItemsSource="{Binding Requests}">
            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add request" Command="{Binding AddRequestCommand}" />
                  <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" />
                  <Separator />
                  <MenuItem Header="Delete collection" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>

              <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Margin="0,0,8,0"
                        Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
              <TextBox Grid.Column="1" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}"
                       AttachedToVisualTree="OnRenameBoxAttached" LostFocus="OnRenameBoxLostFocus"
                       MinHeight="26" Padding="6,2">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <TextBlock Grid.Column="2" Text="{Binding Requests.Count}" Classes="muted" FontSize="11"
                         VerticalAlignment="Center" Margin="8,0,4,0" />
            </Grid>
          </TreeDataTemplate>

          <DataTemplate DataType="vm:RequestNodeViewModel">
            <Grid ColumnDefinitions="40,*" Background="Transparent" Tapped="OnRequestTapped"
                  ToolTip.Tip="{Binding Model.Url}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                  <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <TextBlock Classes="method" Text="{Binding Method, Converter={x:Static conv:MethodTextConverter.Instance}}"
                         Foreground="{Binding Method, Converter={x:Static conv:MethodBrushConverter.Instance}}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </Panel>
  </DockPanel>
</UserControl>
