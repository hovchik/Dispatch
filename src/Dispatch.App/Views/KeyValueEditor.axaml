<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dispatch.App.ViewModels"
             xmlns:conv="using:Dispatch.App.Converters"
             x:Class="Dispatch.App.Views.KeyValueEditor"
             x:DataType="vm:KeyValueListViewModel">

  <DockPanel>
    <!-- Bulk edit: the same rows as "key: value" lines, handy for pasting headers or form fields. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                Margin="0,0,0,6" IsVisible="{Binding SupportsBulkEdit}">
      <TextBlock IsVisible="{Binding IsBulkEdit}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                 Text="One 'key: value' per line. Prefix a line with // to disable it." />
      <Button Padding="10,3" FontSize="12" Command="{Binding ToggleBulkEditCommand}">
        <Panel>
          <TextBlock Text="Bulk Edit" IsVisible="{Binding !IsBulkEdit}" />
          <TextBlock Text="Key-Value Edit" IsVisible="{Binding IsBulkEdit}" />
        </Panel>
      </Button>
    </StackPanel>

    <Panel>
      <TextBox IsVisible="{Binding IsBulkEdit}" Classes="mono" Text="{Binding BulkText}"
               AcceptsReturn="True" TextWrapping="NoWrap" Watermark="key: value"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />

      <Border Classes="card" ClipToBounds="True" IsVisible="{Binding !IsBulkEdit}">
        <DockPanel>
          <!-- Header -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="36,*,*,Auto,36" Height="30">
              <TextBlock Grid.Column="1" Classes="section" Text="{Binding KeyWatermark}" Margin="8,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="section" Text="{Binding ValueWatermark}" Margin="8,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="section" Text="SECRET" Margin="8,0" VerticalAlignment="Center"
                         IsVisible="{Binding SupportsSecret}"
                         ToolTip.Tip="Secret values are masked, encrypted at rest and never exported" />
              <TextBlock Grid.Column="3" Classes="section" Text="TYPE" Margin="8,0" VerticalAlignment="Center"
                         IsVisible="{Binding SupportsFile}" />
            </Grid>
          </Border>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyValueRowViewModel">
                  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="36,*,*,Auto,36">
                      <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" IsVisible="{Binding !IsPlaceholder}"
                                HorizontalAlignment="Center" MinWidth="0" Padding="0"
                                ToolTip.Tip="Include this row" />
                      <TextBox Grid.Column="1" Classes="cell" Text="{Binding Key}" Watermark="{Binding KeyWatermark}" />
                      <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="{DynamicResource DividerBrush}" />
                      <TextBox Grid.Column="2" Classes="cell" Text="{Binding Value}" Watermark="{Binding ValueWatermark}"
                               PasswordChar="{Binding MaskChar}" IsReadOnly="{Binding IsFile}" />

                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="4,0">
                        <ToggleButton IsChecked="{Binding IsSecret}" IsVisible="{Binding SupportsSecret}"
                                      Classes="icon" Padding="6" Background="Transparent" BorderThickness="0"
                                      ToolTip.Tip="Secret: mask and encrypt this value">
                          <PathIcon Data="{StaticResource IconKey}" Width="13" Height="13" />
                        </ToggleButton>
                        <ComboBox IsVisible="{Binding SupportsFile}" Classes="compact" MinWidth="72"
                                  SelectedIndex="{Binding IsFile, Converter={x:Static conv:BoolIndexConverter.Instance}}">
                          <ComboBoxItem Content="Text" />
                          <ComboBoxItem Content="File" />
                        </ComboBox>
                        <Button IsVisible="{Binding IsFile}" Classes="icon" Command="{Binding ChooseFileCommand}"
                                ToolTip.Tip="Choose file">
                          <PathIcon Data="{StaticResource IconFile}" />
                        </Button>
                      </StackPanel>

                      <Button Grid.Column="4" Classes="icon" Command="{Binding RemoveCommand}"
                              IsVisible="{Binding !IsPlaceholder}" ToolTip.Tip="Remove">
                        <PathIcon Data="{StaticResource IconTrash}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
