<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dispatch.App.App"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:avedit="using:AvaloniaEdit"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Brand accent (used by Fluent for primary buttons, focus, selection). -->
      <Color x:Key="SystemAccentColor">#FF6C37</Color>
      <Color x:Key="SystemAccentColorDark1">#E85A28</Color>
      <Color x:Key="SystemAccentColorDark2">#CC4E22</Color>
      <Color x:Key="SystemAccentColorLight1">#FF8559</Color>
      <Color x:Key="SystemAccentColorLight2">#FF9E7A</Color>

      <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, JetBrains Mono, Menlo, monospace</FontFamily>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1C1F" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#232428" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2A2B30" />
          <SolidColorBrush x:Key="DividerBrush" Color="#34363C" />
          <SolidColorBrush x:Key="HoverBrush" Color="#303238" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA0A6" />
          <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#3A2023" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F1F4" />
          <SolidColorBrush x:Key="DividerBrush" Color="#E2E4E8" />
          <SolidColorBrush x:Key="HoverBrush" Color="#ECEEF1" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
          <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FDECEC" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Icons (24x24 path data). -->
      <StreamGeometry x:Key="IconPlus">M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M9,3 H15 V5 H20 V7 H4 V5 H9 Z M6,8 H18 L17,21 H7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M3,5 H10 L12,7 H21 V19 H3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCopy">M8,3 H20 V17 H8 Z M4,7 H6 V19 H16 V21 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconMoon">M12,3 A9,9 0 1 0 21,12 A7,7 0 1 1 12,3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSave">M5,3 H17 L21,7 V21 H3 V3 Z M7,5 V9 H15 V5 Z M12,13 A3,3 0 1 0 12.01,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSend">M3,20 L21,12 L3,4 L3,10 L15,12 L3,14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconImport">M11,3 H13 V13 L16.5,9.5 L18,11 L12,17 L6,11 L7.5,9.5 L11,13 Z M4,19 H20 V21 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M7,4 L20,12 L7,20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFlow">M4,4 H10 V8 H4 Z M14,4 H20 V8 H14 Z M9,16 H15 V20 H9 Z M7,8 V12 H17 V8 M12,12 V16</StreamGeometry>
      <StreamGeometry x:Key="IconChevronUp">M12,8 L19,15 L17.6,16.4 L12,10.8 L6.4,16.4 L5,15 Z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M5,9 L6.4,7.6 L12,13.2 L17.6,7.6 L19,9 L12,16 Z</StreamGeometry>
      <StreamGeometry x:Key="IconServer">M4,4 H20 V10 H4 Z M4,14 H20 V20 H4 Z M7,6 H9 V8 H7 Z M7,16 H9 V18 H7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconShield">M12,2 L20,5 V11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 V5 Z M12,6 A2,2 0 0 0 10,8 A2,2 0 0 0 11,9.7 V13 H13 V9.7 A2,2 0 0 0 14,8 A2,2 0 0 0 12,6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconChart">M4,20 V4 H6 V18 H20 V20 Z M8,16 V11 H11 V16 Z M13,16 V7 H16 V16 Z M18,16 V13 H20 V16 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCookie">M12,3 A9,9 0 1 0 21,12 A3,3 0 0 1 17,9 A3,3 0 0 1 13,5 A2,2 0 0 1 12,3 Z M9,9 A1,1 0 1 0 9.01,9 Z M8,14 A1,1 0 1 0 8.01,14 Z M13,16 A1,1 0 1 0 13.01,16 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCode">M8.5,6 L10,7.5 L5.5,12 L10,16.5 L8.5,18 L2.5,12 Z M15.5,6 L21.5,12 L15.5,18 L14,16.5 L18.5,12 L14,7.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 Z M10,5 A5,5 0 1 0 10,15 A5,5 0 1 0 10,5 Z M15,16.4 L16.4,15 L21,19.6 L19.6,21 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M10,2 H14 L14.6,5 L17,6.2 L19.8,4.8 L22,8.2 L19.9,10.3 V13.7 L22,15.8 L19.8,19.2 L17,17.8 L14.6,19 L14,22 H10 L9.4,19 L7,17.8 L4.2,19.2 L2,15.8 L4.1,13.7 V10.3 L2,8.2 L4.2,4.8 L7,6.2 L9.4,5 Z M12,9 A3,3 0 1 0 12.01,9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDiff">M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z M11,17 H21 V19 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconExport">M11,17 H13 V7 L16.5,10.5 L18,9 L12,3 L6,9 L7.5,10.5 L11,7 Z M4,19 H20 V21 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconKey">M7,9 A5,5 0 1 1 11.6,12 L21,12 V15 H19 V17 H16 V15 H11.6 A5,5 0 0 1 7,9 Z M7,7 A2,2 0 1 0 7.01,7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M6,2 H14 L20,8 V22 H6 Z M13,3.5 V9 H18.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M12,4 A8,8 0 0 1 19.7,10 H17.6 A6,6 0 1 0 18,14 H20.1 A8,8 0 1 1 12,4 Z M20,4 V10 H14 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.method">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Compact tab strips (response Body/Headers). -->
    <Style Selector="TabControl.compact TabItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Segmented switch (e.g. Pretty / Raw). -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Button.seg">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.seg.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seg.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="ComboBox.compact">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.icon.compact">
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Syntax-highlighted body editors (request body, response body). -->
    <Style Selector="views|CodeEditor">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="views|CodeEditor avedit|TextEditor">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="LineNumbersForeground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Compact, borderless inputs used in key/value grids. -->
    <Style Selector="TextBox.cell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- Inline rename box inside a request tab header. -->
    <Style Selector="TextBox.tabrename">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Fluent's default tab headers are very large; make them fit a dense tool UI. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Request tab strip -->
    <Style Selector="ListBox.tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="ListBox.tabs TextBlock.unsaved">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- The tab's save button only shows on hover or for the selected tab. -->
    <Style Selector="ListBox.tabs Button.tabsave">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.tabsave">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected Button.tabsave">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs Button.tabclose.dirty">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.tabclose">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover Ellipse.dirtydot">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Protocol / method badges -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Toolbar buttons with icon + text -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
    </Style>

    <!-- Stream message log -->
    <Style Selector="Border.message">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- Form labels -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Selectable list rows in the sidebar (history). -->
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Application.Styles>
</Application>
