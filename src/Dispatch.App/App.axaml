<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dispatch.App.App"
             xmlns:views="using:Dispatch.App.Views"
             xmlns:avedit="using:AvaloniaEdit"
             xmlns:tools="using:Dispatch.App.ViewModels.Tools"
             xmlns:rep="using:Dispatch.Application.Reporting"
             RequestedThemeVariant="Dark">

  <!--
    Dispatch design system.

    Tokens are semantic (surface, text, border, accent, status) and come in a dark and a light set.
    Fluent's own resource keys are overridden here so every built-in control (text boxes, combo boxes,
    buttons, tabs, lists, menus, tool tips, scroll bars) wears the same palette without per-view styling.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- Brand accent: electric blue. Fluent uses SystemAccentColor for focus, selection and primary buttons. -->
      <Color x:Key="SystemAccentColor">#3B7BFF</Color>
      <Color x:Key="SystemAccentColorDark1">#2F6BFF</Color>
      <Color x:Key="SystemAccentColorDark2">#2457D6</Color>
      <Color x:Key="SystemAccentColorDark3">#1B44AD</Color>
      <Color x:Key="SystemAccentColorLight1">#5B8CFF</Color>
      <Color x:Key="SystemAccentColorLight2">#8AAEFF</Color>
      <Color x:Key="SystemAccentColorLight3">#B9CFFF</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#3B7BFF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B8CFF" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#2457D6" />

      <!-- Signature gradient: sky → electric blue → indigo. Used on primary buttons and the logo mark. -->
      <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#1FA2FF" />
        <GradientStop Offset="0.55" Color="#2F6BFF" />
        <GradientStop Offset="1" Color="#4F46E5" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#4DB8FF" />
        <GradientStop Offset="0.55" Color="#5B8CFF" />
        <GradientStop Offset="1" Color="#6D66F0" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentGradientPressedBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#1785D6" />
        <GradientStop Offset="0.55" Color="#2457D6" />
        <GradientStop Offset="1" Color="#3F37C2" />
      </LinearGradientBrush>

      <!-- Status colors (same in both themes; the soft variants are tints for backgrounds). -->
      <SolidColorBrush x:Key="SuccessBrush" Color="#22A06B" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2622A06B" />
      <SolidColorBrush x:Key="WarningBrush" Color="#E3A008" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#26E3A008" />
      <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444" />
      <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="InfoSoftBrush" Color="#263B82F6" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3B7BFF" />
      <SolidColorBrush x:Key="AccentFaintBrush" Color="#143B7BFF" />

      <FontFamily x:Key="MonoFont">Cascadia Code, JetBrains Mono, Fira Code, Consolas, Menlo, monospace</FontFamily>

      <!-- Shared shape tokens. -->
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
      <Thickness x:Key="TextControlThemePadding">10,6,10,6</Thickness>
      <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
      <x:Double x:Key="ComboBoxMinHeight">32</x:Double>
      <Thickness x:Key="ButtonPadding">12,6</Thickness>
      <Thickness x:Key="ComboBoxPadding">10,0,0,0</Thickness>
      <x:Double x:Key="ScrollBarSize">10</x:Double>
      <x:Double x:Key="TabItemPipeThickness">2</x:Double>
      <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!-- Surfaces -->
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121316" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1B1F" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#212227" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#25262C" />
          <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#141518" />
          <SolidColorBrush x:Key="DividerBrush" Color="#2A2C33" />
          <SolidColorBrush x:Key="DividerStrongBrush" Color="#383B44" />
          <SolidColorBrush x:Key="HoverBrush" Color="#26282E" />
          <SolidColorBrush x:Key="PressedBrush" Color="#2D3037" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#2A3350" />
          <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#33211F" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#88000000" />
          <!-- Text -->
          <SolidColorBrush x:Key="TextBrush" Color="#ECEEF2" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3B8C2" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#8A909C" />
          <SolidColorBrush x:Key="TextFaintBrush" Color="#5C626E" />

          <!-- Fluent overrides: inputs -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#141518" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#17181C" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#121316" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2E3038" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3C3F49" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3B7BFF" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6B7180" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#ECEEF2" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#141518" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1C1D22" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1C1D22" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E3038" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3C3F49" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3B7BFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1F2025" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#383B44" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#2A2C33" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2A3350" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#33406A" />
          <!-- Buttons -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#26282E" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F323A" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1F2126" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1F2024" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33363E" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#424650" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33363E" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#ECEEF2" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C626E" />
          <SolidColorBrush x:Key="SplitButtonBackground" Color="#26282E" />
          <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#2F323A" />
          <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#1F2126" />
          <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="#33363E" />
          <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="#424650" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#26282E" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2F323A" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#33363E" />
          <!-- Lists, trees, tabs -->
          <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#26282E" />
          <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#2D3037" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#2A3350" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#33406A" />
          <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#33406A" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#26282E" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#2A3350" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#33406A" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#33406A" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#3B7BFF" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#ECEEF2" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#ECEEF2" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#8A909C" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#C8CCD4" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="Transparent" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="Transparent" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="Transparent" />
          <!-- Menus, flyouts, tool tips -->
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1F2025" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#383B44" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2A2C33" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2D3037" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#1F2025" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#383B44" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#2A2C33" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3C3F49" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#ECEEF2" />
          <!-- Misc -->
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#4A4E59" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#141518" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#3B7BFF" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#5B8CFF" />
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#212227" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#26282E" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#2A2C33" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="#1A1B1F" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#2A2C33" />
          <Color x:Key="ScrollBarThumbBackgroundColor">#4A4E59</Color>
          <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
          <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#212227" />
          <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="#8A909C" />
          <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#2A2C33" />
          <Color x:Key="DataGridRowHoveredBackgroundColor">#26282E</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F3F5" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F6F7F9" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F6F7F9" />
          <SolidColorBrush x:Key="DividerBrush" Color="#E4E6EA" />
          <SolidColorBrush x:Key="DividerStrongBrush" Color="#CFD3DA" />
          <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F3" />
