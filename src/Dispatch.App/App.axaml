          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F3F4F6" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E9EBEF" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F3F4F6" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D5D9E0" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B9BFC9" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B9BFC9" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#1B1F27" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#9AA1AD" />
          <SolidColorBrush x:Key="SplitButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#F3F4F6" />
          <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#E9EBEF" />
          <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="#D5D9E0" />
