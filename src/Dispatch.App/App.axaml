      <StreamGeometry x:Key="IconSearch">M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 Z M10,5 A5,5 0 1 0 10,15 A5,5 0 1 0 10,5 Z M15,16.4 L16.4,15 L21,19.6 L19.6,21 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M10,2 H14 L14.6,5 L17,6.2 L19.8,4.8 L22,8.2 L19.9,10.3 V13.7 L22,15.8 L19.8,19.2 L17,17.8 L14.6,19 L14,22 H10 L9.4,19 L7,17.8 L4.2,19.2 L2,15.8 L4.1,13.7 V10.3 L2,8.2 L4.2,4.8 L7,6.2 L9.4,5 Z M12,9 A3,3 0 1 0 12.01,9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDiff">M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z M11,17 H21 V19 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconExport">M11,17 H13 V7 L16.5,10.5 L18,9 L12,3 L6,9 L7.5,10.5 L11,7 Z M4,19 H20 V21 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLock">M7,10 V7 A5,5 0 0 1 17,7 V10 H19 V21 H5 V10 Z M9,10 H15 V7 A3,3 0 0 0 9,7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconKey">M7,9 A5,5 0 1 1 11.6,12 L21,12 V15 H19 V17 H16 V15 H11.6 A5,5 0 0 1 7,9 Z M7,7 A2,2 0 1 0 7.01,7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M6,2 H14 L20,8 V22 H6 Z M13,3.5 V9 H18.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconHelp">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M11,16 H13 V18 H11 Z M12,6 A4,4 0 0 0 8,10 H10 A2,2 0 1 1 12,12 H11 V15 H13 V13.9 A4,4 0 0 0 12,6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFlask">M9,2 H15 V4 H14 V9 L20,19 A2,2 0 0 1 18.3,22 H5.7 A2,2 0 0 1 4,19 L10,9 V4 H9 Z M12,4 V9.6 L9.6,13.5 H14.4 L12,9.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconGauge">M12,4 A10,10 0 0 0 2,14 A10,10 0 0 0 3.3,19 H20.7 A10,10 0 0 0 22,14 A10,10 0 0 0 12,4 Z M12,6 A8,8 0 0 1 19.6,17 H4.4 A8,8 0 0 1 12,6 Z M16.9,8.5 L13.3,13.2 A2,2 0 1 1 11.6,12.1 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M12,4 A8,8 0 0 1 19.7,10 H17.6 A6,6 0 1 0 18,14 H20.1 A8,8 0 1 1 12,4 Z M20,4 V10 H14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCollections">M4,4 H11 L13,6 H20 V9 H4 Z M3,10 H21 L20,20 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconGlobe">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,4 A8,8 0 0 1 19.7,11 H15.9 A14,14 0 0 0 14.1,4.3 A8,8 0 0 1 12,4 Z M9.9,4.3 A14,14 0 0 0 8.1,11 H4.3 A8,8 0 0 1 9.9,4.3 Z M10.1,11 A12,12 0 0 1 12,5.2 A12,12 0 0 1 13.9,11 Z M4.3,13 H8.1 A14,14 0 0 0 9.9,19.7 A8,8 0 0 1 4.3,13 Z M10.1,13 H13.9 A12,12 0 0 1 12,18.8 A12,12 0 0 1 10.1,13 Z M15.9,13 H19.7 A8,8 0 0 1 14.1,19.7 A14,14 0 0 0 15.9,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBraces">M8,3 H10 V5 H9 V9.5 A2,2 0 0 1 7.5,11.4 L6.8,12 L7.5,12.6 A2,2 0 0 1 9,14.5 V19 H10 V21 H8 A2,2 0 0 1 6,19 V15 L4,12 L6,9 V5 A2,2 0 0 1 8,3 Z M16,3 A2,2 0 0 1 18,5 V9 L20,12 L18,15 V19 A2,2 0 0 1 16,21 H14 V19 H15 V14.5 A2,2 0 0 1 16.5,12.6 L17.2,12 L16.5,11.4 A2,2 0 0 1 15,9.5 V5 H14 V3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLayoutRows">M3,4 H21 V11 H3 Z M3,13 H21 V20 H3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLayoutColumns">M3,4 H11 V20 H3 Z M13,4 H21 V20 H13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSidebar">M3,4 H21 V20 H3 Z M5,6 V18 H9 V6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M9.5,16.2 L5.3,12 L3.9,13.4 L9.5,19 L20.1,8.4 L18.7,7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconWarning">M12,2.5 L22.5,20.5 H1.5 Z M11,9 H13 V14.5 H11 Z M11,16 H13 V18 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M11,10 H13 V17 H11 Z M11,7 H13 V9 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSparkle">M12,2 L13.8,8.2 L20,10 L13.8,11.8 L12,18 L10.2,11.8 L4,10 L10.2,8.2 Z M19,15 L19.9,17.1 L22,18 L19.9,18.9 L19,21 L18.1,18.9 L16,18 L18.1,17.1 Z M5,16 L5.7,17.3 L7,18 L5.7,18.7 L5,20 L4.3,18.7 L3,18 L4.3,17.3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconArrowRight">M4,11 H16.2 L11.6,6.4 L13,5 L20,12 L13,19 L11.6,17.6 L16.2,13 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTerminal">M3,4 H21 V20 H3 Z M5,6 V18 H19 V6 Z M7,8 L11,11 L7,14 V12.4 L9,11 L7,9.6 Z M12,14 H17 V15.6 H12 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDots">M5,10 A2,2 0 1 0 5.01,10 Z M12,10 A2,2 0 1 0 12.01,10 Z M19,10 A2,2 0 1 0 19.01,10 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBolt">M13,2 L4,14 H11 L10,22 L20,9 H13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFilter">M3,4 H21 L14,12.5 V20 L10,18 V12.5 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Building blocks shared by the report views (load test, runner, capture, mock server). -->
  <Application.DataTemplates>
    <DataTemplate DataType="tools:StatTile">
      <Border Classes="stat">
        <StackPanel Spacing="2">
          <TextBlock Classes="eyebrow" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="statvalue" Text="{Binding Value}" IsVisible="{Binding Accent, Converter={x:Static ObjectConverters.IsNull}}" />
          <TextBlock Classes="statvalue" Text="{Binding Value}" Foreground="{Binding Accent}"
                     IsVisible="{Binding Accent, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="muted" FontSize="11" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="tools:ReportBar">
      <Grid ColumnDefinitions="110,*,64" ColumnSpacing="10" Margin="0,3">
        <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Label}" />
        <ProgressBar Grid.Column="1" Classes="bar" Value="{Binding Count}" Maximum="{Binding Max}" Foreground="{Binding Brush}" />
        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="rep:ReportInsight">
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6"
              BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
        <Grid ColumnDefinitions="26,*">
          <Border Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0"
                  Background="{Binding Level, Converter={x:Static tools:InsightBrushConverter.Instance}}">
            <TextBlock Text="{Binding Level, Converter={x:Static tools:InsightGlyphConverter.Instance}}" Foreground="White"
                       FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
        </Grid>
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- ========== Base ========== -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MaxWidth" Value="420" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <!-- Spinner arrows sit flat inside the field instead of looking like two separate buttons. -->
    <Style Selector="ButtonSpinner RepeatButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="ButtonSpinner RepeatButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ButtonSpinner RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ButtonSpinner RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ProgressBar:horizontal">
      <Setter Property="MinHeight" Value="6" />
    </Style>

    <!-- ========== Typography ========== -->
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.faint">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <!-- Small upper-case group heading. -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.method">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="LetterSpacing" Value="0.3" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Keyboard shortcut chip. -->
    <Style Selector="Border.kbd">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- ========== Inputs ========== -->
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <!-- Compact, borderless inputs used in key/value grids. -->
    <Style Selector="TextBox.cell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBox.cell /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    </Style>
    <!-- Inputs that sit inside a composite bar (the address bar) draw no chrome of their own. -->
    <Style Selector="TextBox.bare">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.bare">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBox.bare /template/ Border#Background">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.bare:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ComboBox.bare /template/ Border#HighlightBackground">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Inline rename box inside a tab header or tree row. -->
    <Style Selector="TextBox.tabrename, TextBox.rename">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox.compact">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========== Buttons ========== -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="SplitButton">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <!-- Primary buttons wear the brand gradient. -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter, SplitButton.accent /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradientHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradientPressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Destructive actions. -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Ghost buttons: no chrome until hovered. -->
    <Style Selector="Button.ghost, Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter, Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
    </Style>
    <!-- Icon-only buttons. -->
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.icon.compact">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <!-- Inline links (e.g. "Learn more"). -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- Segmented switch (e.g. Pretty / Raw). -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.seg">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.seg /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.seg.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seg.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- ========== Activity rail (left edge of the main window) ========== -->
    <Style Selector="Border.rail">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Width" Value="68" />
    </Style>
    <Style Selector="Button.railitem, ToggleButton.railitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,6,0,5" />
      <Setter Property="Margin" Value="5,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="58" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.railitem /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.railitem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.railitem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.railitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.railitem:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.railitem:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.railitem PathIcon, ToggleButton.railitem PathIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
    </Style>
    <Style Selector="Button.railitem TextBlock, ToggleButton.railitem TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- ========== Surfaces ========== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.card.raised">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrongBrush}" />
    </Style>
    <!-- A titled settings / report group. -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <!-- Report building blocks -->
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.statvalue">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="ProgressBar.bar">
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Status pill (Running / Stopped, 200 OK). -->
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Protocol / method badges -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Small count chip next to a label (e.g. "Headers 5"). -->
    <Style Selector="Border.count">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.count TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Banners (error / info) -->
    <Style Selector="Border.banner">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.banner.error">
      <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBrush}" />
    </Style>
    <Style Selector="Border.banner.info">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <!-- Stream message log rows -->
    <Style Selector="Border.message">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <!-- Sidebar panel header row -->
    <Style Selector="Border.sidebarHeader">
      <Setter Property="Padding" Value="14,10,8,6" />
    </Style>
    <Style Selector="Border.sidebarHeader TextBlock.sidebarTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Toolbar row above an editor (sub-tab chrome). -->
    <Style Selector="Border.toolbar">
      <Setter Property="Padding" Value="0,0,0,8" />
    </Style>

    <!-- ========== Tabs ========== -->
    <!-- Underline-style tab headers that fit a dense tool UI. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
    <!-- Tabs with a count chip in their header. -->
    <Style Selector="TabItem Border.count">
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <!-- Compact tab strips (response Body/Headers). -->
    <Style Selector="TabControl.compact TabItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- ========== Request tab strip (browser-style) ========== -->
    <Style Selector="ListBox.tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem TextBlock.tabtitle">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected TextBlock.tabtitle">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover TextBlock.tabtitle">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ListBox.tabs TextBlock.unsaved">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- The accent line that marks the active tab. -->
    <Style Selector="ListBox.tabs ListBoxItem Border.tabline">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected Border.tabline">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The tab's save button only shows on hover or for the selected tab. -->
    <Style Selector="ListBox.tabs Button.tabsave">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.tabsave">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected Button.tabsave">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs Button.tabclose">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="ListBox.tabs Button.tabclose.dirty">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.tabclose">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover Ellipse.dirtydot">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- ========== Lists ========== -->
    <!-- Selectable list rows in the sidebar (history, palette). -->
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="RowHeight" Value="30" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- ========== Code editors ========== -->
    <Style Selector="views|CodeEditor">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    </Style>
    <Style Selector="views|CodeEditor avedit|TextEditor">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="LineNumbersForeground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
  </Application.Styles>
</Application>
