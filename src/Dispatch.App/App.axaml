          <SolidColorBrush x:Key="SelectedBrush" Color="#E3ECFF" />
          <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FDECEC" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#66111827" />
          <SolidColorBrush x:Key="TextBrush" Color="#1B1F27" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#444B57" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
          <SolidColorBrush x:Key="TextFaintBrush" Color="#9AA1AD" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D5D9E0" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B9BFC9" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3B7BFF" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9AA1AD" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#1B1F27" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F9FAFB" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F3F4F6" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D5D9E0" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B9BFC9" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3B7BFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D5D9E0" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EEF0F3" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E3ECFF" />
